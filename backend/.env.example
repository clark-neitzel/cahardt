# Configuração do Banco de Dados (PostgreSQL)
# Exemplo local: postgresql://user:password@localhost:5432/dbname
# Exemplo produção (EasyPanel): postgres://user:password@host:5432/dbname
DATABASE_URL="postgres://usuario:senha@host:5432/banco"

# Porta do Servidor
PORT=3000

# Motor de Orientação Comercial (GPT)
OPENAI_API_KEY="sk-..."

# Versão do build — preencher antes de cada deploy no EasyPanel (ex: git hash ou timestamp)
# Exemplo: APP_VERSION=a1b2c3d  ou  APP_VERSION=20260421-1430
APP_VERSION=

# Chave da API de consulta somente-leitura para IA externa (ex.: bot de WhatsApp / Antigravity).
# Gere uma string aleatória longa e cole também na configuração do bot (header x-ia-api-key).
# NUNCA usar o ADMIN_SECRET aqui.
IA_WHATSAPP_API_KEY=

# ── Envio de WhatsApp pelo bot da Ana (substituiu o BotConversa em 07/2026) ──
# TODA mensagem do sistema (pedido, código de verificação, entrega, cobrança) sai por aqui.
# Sem estas duas, NENHUM WhatsApp é enviado — as mensagens ficam na fila (bot_whatsapp_envios).
# Os valores vêm do painel do bot: Configurações → "Mensagens automáticas do sistema".
# Contrato: INTEGRACAO-ENVIO-BOT-WHATSAPP.md (raiz do repo).
BOT_WHATSAPP_URL=
BOT_WHATSAPP_API_KEY=

# ── IA (Clippy e Análise IA de clientes) ──
# Provider: openai (padrão) ou gemini. Modelo padrão da OpenAI: gpt-6-luna.
# ATENÇÃO: gpt-4o-mini / gpt-4o / gpt-4.1* saem da API da OpenAI em 14/01/2027.
# AI_MODEL=gpt-4o-mini ainda funciona até lá (aiProvider usa max_tokens/temperature nesse caso).
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
