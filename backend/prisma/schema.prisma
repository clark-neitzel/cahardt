model CurriculoHistorico {
  id          Int      @id @default(autoincrement())
  curriculoId Int      @map("curriculo_id")
  vendedorId  String   @map("vendedor_id")
  campo       String
  valorAntes  String?  @map("valor_antes") @db.Text
  valorDepois String?  @map("valor_depois") @db.Text
  criadoEm    DateTime @default(now()) @map("criado_em")

  curriculo Curriculo @relation(fields: [curriculoId], references: [id], onDelete: Cascade)
  vendedor  Vendedor  @relation(fields: [vendedorId], references: [id])

  @@index([curriculoId])
  @@map("curriculo_historico")
}

// ─── Etiquetas de Produtos ────────────────────────────────────────────────────

model EtiquetaProduto {
  id String @id @default(uuid())

  // Vínculo opcional com Produto do catálogo (um produto pode ter várias etiquetas — tamanhos diferentes)
  produtoId String?  @map("produto_id")
  produto   Produto? @relation(fields: [produtoId], references: [id])

  // Identificação
  codigoProduto         String @map("codigo_produto")
  nomeProduto           String @map("nome_produto")
  pesoUnitario          Int    @map("peso_unitario") // gramas
  pesoTabelaNutricional Int    @map("peso_tabela_nutricional") // gramas (porção)

  // Informação Nutricional (texto com unidade + %VD, ex: "34kcal (2% VD)")
  valorEnergetico     String? @map("valor_energetico")
  carboidratos        String?
  acucaresTotais      String? @map("acucares_totais")
  acucaresAdicionados String? @map("acucares_adicionados")
  proteinas           String?
  gordurasTotais      String? @map("gorduras_totais")
  gordurasSaturadas   String? @map("gorduras_saturadas")
  gordurasTrans       String? @map("gorduras_trans")
  fibraAlimentar      String? @map("fibra_alimentar")
  sodio               String?

  // Conteúdo do rótulo
  quantidadeEmbalagem  Int     @map("quantidade_embalagem")
  quantidadeAproximada Boolean @default(false) @map("quantidade_aproximada")
  composicao           String  @db.Text
  modoPreparo          String  @map("modo_preparo") @db.Text
  codigoBarras         String? @map("codigo_barras")

  // Alérgenos
  contemLeite       Boolean  @default(false) @map("contem_leite")
  contemGluten      Boolean  @default(false) @map("contem_gluten")
  contemLactose     Boolean  @default(false) @map("contem_lactose")
  contemOvo         Boolean  @default(false) @map("contem_ovo")
  alergenos         String[] @default([]) // lista RDC 26/2015 marcada (ex: ["Leite","Soja","Ovos"])
  especieCrustaceos String?  @map("especie_crustaceos") // nomes das espécies, ex: "camarão"
  especiePeixes     String?  @map("especie_peixes") // nomes das espécies, ex: "tilápia"
  outrosAlergenos   String?  @map("outros_alergenos")
  avisosRotulo      String?  @map("avisos_rotulo")

  // Conservação
  armazenamento String?
  validadeDias  Int     @default(90) @map("validade_dias")

  // Controle
  ativo       Boolean @default(true)
  tipoProduto String? @map("tipo_produto")
  tarjaPreta  Boolean @default(false) @map("tarja_preta")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([codigoProduto])
  @@map("etiquetas_produtos")
}

// =============================================
// MÓDULO COMISSÕES
// =============================================

model ComissaoConfig {
  id            String @id @default(uuid())
  vendedorId    String @map("vendedor_id")
  mesReferencia String @map("mes_referencia") // Formato "YYYY-MM"

  // Faixas de comissão — cada faixa tem um LIMITE (fronteira em % da meta) e uma TAXA (% de comissão)
  percMinimoMeta Float @default(0) @map("perc_minimo_meta") // % mínimo da meta para ter comissão (abaixo disso, comissão zerada; 0 = sem mínimo)
  faixaAbaixo    Float @default(0) @map("faixa_abaixo") // fronteira inferior: acima de X% abaixo da meta começa a faixa "abaixo" (0 = qualquer valor abaixo da meta)
  percAbaixoMeta Float @default(0) @map("perc_abaixo_meta") // comissão % quando realizado < (meta - faixaAbaixo%)
  percNaMeta     Float @default(0) @map("perc_na_meta") // comissão % quando realizado está entre (meta - faixaAbaixo%) e meta
  faixaAcima     Float @default(0) @map("faixa_acima") // fronteira superior: bônus de excedente só começa além de X% acima da meta (0 = qualquer excedente)
  percAcimaMeta  Float @default(0) @map("perc_acima_meta") // comissão % sobre o excedente além de (meta + faixaAcima%)

  // Bônus independentes
  bonusCidades   Float @default(0) @map("bonus_cidades") // % adicional se bater meta em TODAS as cidades
  bonusProdutos  Float @default(0) @map("bonus_produtos") // % adicional por cada produto que bateu a meta
  bonusFlex      Float @default(0) @map("bonus_flex") // % adicional se uso de flex <= limiteFlexPerc
  limiteFlexPerc Float @default(100) @map("limite_flex_perc") // % máximo de uso do flex para ganhar bônus flex

  // Popup de comissão no app do vendedor (1x por período; horário "" = não mostra no período)
  popupAtivo Boolean @default(true) @map("popup_ativo")
  popupManha String  @default("08:00") @map("popup_manha") // formato HH:MM
  popupTarde String  @default("18:00") @map("popup_tarde") // formato HH:MM

  criadoPor String   @map("criado_por")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@unique([vendedorId, mesReferencia])
  @@index([mesReferencia])
  @@map("comissao_config")
}

// ============================================================
// ── KIT FESTA — Site público de pedidos + Agenda da cozinha ──
// Módulo independente do Delivery* (que é o Kanban pós-pedido).
// Cliente acessa por link, faz pedido; admin aprova e converte
// em Pedido normal/especial.
// ============================================================

// Usuário do site (área do cliente). Pode ou não ter cadastro no CA (clienteUuid).
model KitFestaCliente {
  id        String  @id @default(uuid())
  cpf       String  @unique // só dígitos
  nome      String
  telefone  String?
  email     String?
  senhaHash String? @map("senha_hash") // null = ainda precisa criar senha

  // Vínculo com o cadastro do Conta Azul (quando existe)
  clienteUuid String?  @unique @map("cliente_uuid")
  cliente     Cliente? @relation(fields: [clienteUuid], references: [UUID])

  // Programa de indicação / fidelidade
  pontos           Int               @default(0)
  codigoIndicacao  String?           @unique @map("codigo_indicacao")
  creditoIndicacao Decimal           @default(0) @map("credito_indicacao") @db.Decimal(12, 2)
  indicadoPorId    String?           @map("indicado_por_id")
  indicadoPor      KitFestaCliente?  @relation("KitFestaIndicacao", fields: [indicadoPorId], references: [id])
  indicados        KitFestaCliente[] @relation("KitFestaIndicacao")

  // Recuperação de senha
  resetToken    String?   @map("reset_token")
  resetTokenExp DateTime? @map("reset_token_exp")

  ultimoAcesso DateTime? @map("ultimo_acesso")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  pedidos KitFestaPedido[]

  creditosGanhos  KitFestaCredito[]  @relation("CreditoDono")
  creditosGerados KitFestaCredito[]  @relation("CreditoIndicado")
  cuponsUsados    KitFestaCupomUso[]

  @@index([cpf])
  @@map("kitfesta_clientes")
}

// Histórico de uso de cupom (quem usou, em qual pedido, quanto).
model KitFestaCupomUso {
  id        String          @id @default(uuid())
  cupomId   String          @map("cupom_id")
  cupom     KitFestaCupom   @relation(fields: [cupomId], references: [id], onDelete: Cascade)
  codigo    String
  clienteId String          @map("cliente_id")
  cliente   KitFestaCliente @relation(fields: [clienteId], references: [id])
  pedidoId  String?         @map("pedido_id") // KitFestaPedido
  valor     Decimal         @db.Decimal(12, 2)
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([cupomId])
  @@index([clienteId])
  @@map("kitfesta_cupom_usos")
}

// Crédito de indicação: 1 linha por indicação que gerou crédito ao indicador.
// Gerado quando o pedido do INDICADO é quitado; consumido (1 por pedido) pelo indicador.
model KitFestaCredito {
  id             String           @id @default(uuid())
  donoId         String           @map("dono_id") // quem GANHA/usa o crédito (o indicador)
  dono           KitFestaCliente  @relation("CreditoDono", fields: [donoId], references: [id])
  indicadoId     String?          @map("indicado_id") // quem foi indicado (gerou o crédito)
  indicado       KitFestaCliente? @relation("CreditoIndicado", fields: [indicadoId], references: [id])
  origemPedidoId String?          @map("origem_pedido_id") // pedido do indicado que gerou (quitado)
  valor          Decimal          @db.Decimal(12, 2)
  status         String           @default("DISPONIVEL") // DISPONIVEL | USADO
  usadoPedidoId  String?          @map("usado_pedido_id") // pedido do indicador onde foi usado
  usadoEm        DateTime?        @map("usado_em")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([donoId, status])
  @@map("kitfesta_creditos")
}

// Categorias de exibição no site (ex: Fritos, De forno, Doces). Editável pelo admin.
model KitFestaCategoria {
  id        String   @id @default(uuid())
  nome      String
  slug      String   @unique // ex: 'fritos', 'forno', 'doces'
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  produtos KitFestaProduto[]

  @@map("kitfesta_categorias")
}

// Vincula um Produto do app ao site, com config de exibição.
model KitFestaProduto {
  id        String  @id @default(uuid())
  produtoId String  @unique @map("produto_id")
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  categoriaId String?            @map("categoria_id")
  categoria   KitFestaCategoria? @relation(fields: [categoriaId], references: [id])

  unidadesPorCaixa Int      @default(25) @map("unidades_por_caixa")
  precoKitFesta    Decimal? @map("preco_kitfesta") @db.Decimal(12, 2) // override; null = usa valorVenda do Produto
  descricaoSite    String?  @map("descricao_site") @db.Text
  tags             String[] @default([])
  opcoes           String[] @default([]) // ex: ['Frango','Palmito']
  destaque         Boolean  @default(false) // "Mais pedidos"
  ordem            Int      @default(0)
  ativo            Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  itens KitFestaPedidoItem[]

  @@index([ativo])
  @@map("kitfesta_produtos")
}

// Status do dia na agenda da cozinha. Sem registro = usa default (aberto se houver horário no template).
model KitFestaAgendaDia {
  id         String   @id @default(uuid())
  data       DateTime @unique @db.Date
  status     String   @default("open") // open | few | full | closed
  observacao String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("kitfesta_agenda_dias")
}

// LEGADO — template antigo por dia-da-semana. Mantido para não dropar a coluna em produção.
// Não é mais a fonte dos slots do site (agora é KitFestaHorarioDia, por data específica).
model KitFestaHorarioPadrao {
  id         String   @id @default(uuid())
  modo       String // retirada | entrega
  hora       String // '08:30'
  capacidade Int      @default(10) // pedidos por slot
  diasSemana Int[]    @default([]) @map("dias_semana") // 0=Dom ... 6=Sáb; vazio = todos
  ativo      Boolean  @default(true)
  ordem      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("kitfesta_horarios_padrao")
}

// Slots de horário POR DATA específica (fonte de verdade da agenda).
// Configurados em lote (período) e/ou ajustados por dia no admin.
model KitFestaHorarioDia {
  id         String   @id @default(uuid())
  data       DateTime @db.Date
  modo       String // retirada | entrega
  hora       String // '06:00', '06:30'...
  capacidade Int      @default(10) // pedidos que esse horário aceita
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([data, modo, hora])
  @@index([data])
  @@map("kitfesta_horarios_dia")
}

// Bairros de entrega com CEP e taxa.
model KitFestaBairro {
  id        String   @id @default(uuid())
  nome      String
  cidade    String?  @default("Joinville")
  cep       String? // CEP base ou principal do bairro
  taxa      Decimal  @default(0) @db.Decimal(12, 2)
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  pedidos KitFestaPedido[]

  @@map("kitfesta_bairros")
}

// Cupons de desconto.
model KitFestaCupom {
  id             String    @id @default(uuid())
  codigo         String    @unique
  tipo           String // pct | brl
  valor          Decimal   @db.Decimal(12, 2)
  label          String?
  minCaixas      Int?      @map("min_caixas")
  validade       DateTime? @db.Date
  primeiraCompra Boolean   @default(false) @map("primeira_compra")
  usoMaximo      Int?      @map("uso_maximo") // total de usos permitidos (null = ilimitado)
  usos           Int       @default(0)
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")

  historico KitFestaCupomUso[]

  @@map("kitfesta_cupons")
}

// Pedido feito no site. Entra numa fila; admin aprova e converte em Pedido normal/especial.
model KitFestaPedido {
  id     String @id @default(uuid())
  numero Int    @unique @default(autoincrement())

  // Idempotência: chave enviada pelo bot (WhatsApp IA) para não duplicar pedido em retry/timeout.
  // Null nos pedidos do site. Índice COMUM (não único) — ver nota em CongeladosPedido.idempotencyKey.
  idempotencyKey String? @map("idempotency_key")

  // Cliente do site (sempre presente; pode estar sem cadastro CA)
  kitFestaClienteId String          @map("kitfesta_cliente_id")
  kitFestaCliente   KitFestaCliente @relation(fields: [kitFestaClienteId], references: [id])

  // Snapshot dos dados do cliente no momento do pedido
  nomeCliente     String  @map("nome_cliente")
  cpfCliente      String  @map("cpf_cliente")
  telefoneCliente String? @map("telefone_cliente")
  celularAlterado Boolean @default(false) @map("celular_alterado") // cliente informou/corrigiu o nº no checkout — admin deve atualizar no cadastro
  semCadastro     Boolean @default(false) @map("sem_cadastro") // visitante sem Cliente no app/CA

  // Entrega
  modo            String // retirada | entrega
  data            DateTime        @db.Date
  horario         String
  bairroId        String?         @map("bairro_id")
  bairro          KitFestaBairro? @relation(fields: [bairroId], references: [id])
  taxaEntrega     Decimal         @default(0) @map("taxa_entrega") @db.Decimal(12, 2)
  enderecoEntrega String?         @map("endereco_entrega") @db.Text

  // Valores
  subtotal       Decimal @db.Decimal(12, 2)
  cupomCodigo    String? @map("cupom_codigo")
  descontoValor  Decimal @default(0) @map("desconto_valor") @db.Decimal(12, 2)
  origemDesconto String? @map("origem_desconto") // CUPOM | INDICACAO | CREDITO
  creditoUsadoId String? @map("credito_usado_id") // KitFestaCredito consumido neste pedido
  total          Decimal @db.Decimal(12, 2)
  totalCaixas    Int     @map("total_caixas")

  // Pagamento (quitação) — libera o crédito do indicador
  pago   Boolean   @default(false)
  pagoEm DateTime? @map("pago_em")

  observacoes String? @db.Text

  // Fluxo de aprovação
  // AGUARDANDO | PENDENTE_CADASTRO | APROVADO | RECUSADO | CONVERTIDO | CANCELADO
  status       String  @default("AGUARDANDO")
  motivoRecusa String? @map("motivo_recusa") @db.Text

  // Conversão para Pedido normal
  tipoConversao String?   @map("tipo_conversao") // NORMAL | ESPECIAL | BONIFICACAO
  pedidoId      String?   @unique @map("pedido_id")
  pedido        Pedido?   @relation(fields: [pedidoId], references: [id])
  aprovadoPorId String?   @map("aprovado_por_id")
  aprovadoEm    DateTime? @map("aprovado_em")

  whatsappEnviado Boolean @default(false) @map("whatsapp_enviado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  itens KitFestaPedidoItem[]

  @@index([status])
  @@index([data])
  @@index([kitFestaClienteId])
  @@index([idempotencyKey])
  @@map("kitfesta_pedidos")
}

model KitFestaPedidoItem {
  id               String         @id @default(uuid())
  kitFestaPedidoId String         @map("kitfesta_pedido_id")
  kitFestaPedido   KitFestaPedido @relation(fields: [kitFestaPedidoId], references: [id], onDelete: Cascade)

  kitFestaProdutoId String?          @map("kitfesta_produto_id")
  kitFestaProduto   KitFestaProduto? @relation(fields: [kitFestaProdutoId], references: [id])

  nomeProduto      String  @map("nome_produto")
  opcao            String? // ex: 'Frango' / 'Palmito'
  quantidade       Int // nº de caixas
  unidadesPorCaixa Int     @map("unidades_por_caixa")
  precoUnitario    Decimal @map("preco_unitario") @db.Decimal(12, 2)

  @@map("kitfesta_pedido_itens")
}

// Configurações do site (chave/valor). Ex: hero, como_funciona, loja, regras, frete_texto.
model KitFestaConfig {
  chave     String   @id
  valor     Json?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("kitfesta_config")
}

// Avaliações exibidas no site, gerenciadas pelo admin.
model KitFestaAvaliacao {
  id        String   @id @default(uuid())
  nome      String
  evento    String?
  texto     String   @db.Text
  estrelas  Int      @default(5)
  dataLabel String?  @map("data_label")
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("kitfesta_avaliacoes")
}

// =============================================
// SITE CONGELADOS (B2B / revenda)
// Espelha a arquitetura do Kit Festa, mas personalizado por cliente:
// preços, condições de pagamento e dias de entrega vêm do cadastro do app.
// =============================================

// Login do cliente do site de congelados. CPF ou CNPJ (só dígitos).
model CongeladosCliente {
  id        String  @id @default(uuid())
  documento String  @unique // só dígitos (CPF 11 ou CNPJ 14)
  nome      String
  telefone  String?
  email     String?
  senhaHash String? @map("senha_hash") // null = ainda precisa criar senha

  // Vínculo com o cadastro do Conta Azul (quando existe)
  clienteUuid String?  @unique @map("cliente_uuid")
  cliente     Cliente? @relation(fields: [clienteUuid], references: [UUID])

  // Recuperação de senha
  resetToken    String?   @map("reset_token")
  resetTokenExp DateTime? @map("reset_token_exp")

  ultimoAcesso DateTime? @map("ultimo_acesso")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  pedidos CongeladosPedido[]

  @@index([documento])
  @@map("congelados_clientes")
}

// Vincula um Produto do app ao catálogo de congelados, com config de exibição.
// A categoria de filtro vem da CategoriaProduto (categoria comercial) do próprio Produto.
model CongeladosProduto {
  id        String  @id @default(uuid())
  produtoId String  @unique @map("produto_id")
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  unidadesPorCaixa Int      @default(0) @map("unidades_por_caixa") // 0 = usa a unidade do produto
  embalagem        String   @default("caixa") // rótulo da embalagem no site (caixa, pacote, unidade...)
  nomeSite         String?  @map("nome_site") // nome exibido no site; null = nome do sistema. O pedido no sistema sempre usa o nome do sistema.
  precoCongelados  Decimal? @map("preco_congelados") @db.Decimal(12, 2) // override; null = usa valorVenda
  descricaoSite    String?  @map("descricao_site") @db.Text
  destaque         Boolean  @default(false) // "Mais pedidos" na home
  ordem            Int      @default(0)
  ativo            Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  itens CongeladosPedidoItem[]

  @@index([ativo])
  @@map("congelados_produtos")
}

// Pedido feito no site de congelados. Entra numa fila; admin vincula/aprova e
// converte em Pedido normal ou especial (respeitando a condição de pagamento).
model CongeladosPedido {
  id     String @id @default(uuid())
  numero Int    @unique @default(autoincrement())

  // Idempotência: chave enviada pelo bot (WhatsApp IA) para não duplicar pedido em retry/timeout.
  // Null nos pedidos do site. Índice COMUM (não único) de propósito: o deploy roda `prisma db push`
  // sem --accept-data-loss e ele RECUSA criar índice único (quebraria o deploy). A dedupe é por
  // checagem da chave no código + a fila de aprovação humana como rede.
  idempotencyKey String? @map("idempotency_key")

  congeladosClienteId String            @map("congelados_cliente_id")
  congeladosCliente   CongeladosCliente @relation(fields: [congeladosClienteId], references: [id])

  // Snapshot dos dados do cliente no momento do pedido
  nomeCliente      String  @map("nome_cliente")
  documentoCliente String  @map("documento_cliente")
  telefoneCliente  String? @map("telefone_cliente")
  celularAlterado  Boolean @default(false) @map("celular_alterado")
  semCadastro      Boolean @default(false) @map("sem_cadastro") // visitante sem Cliente no app/CA

  // Condição de pagamento e entrega escolhidas (vindas do cadastro do cliente)
  tabelaPrecoId String?   @map("tabela_preco_id") // id da TabelaPreco (condição) escolhida
  condicaoNome  String?   @map("condicao_nome")
  diaEntrega    String?   @map("dia_entrega")
  dataEntrega   DateTime? @map("data_entrega") // data de entrega/retirada escolhida no site
  modo          String    @default("entrega") // entrega | retirada (retirar na loja)
  encaixe       Boolean   @default(false) // pedido fora do dia regular do cliente (equipe verifica viabilidade)

  // Valores
  subtotal    Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  totalCaixas Int     @map("total_caixas")

  observacoes String? @db.Text

  // Fluxo: AGUARDANDO | PENDENTE_CADASTRO | RECUSADO | CONVERTIDO | CANCELADO
  status       String  @default("AGUARDANDO")
  motivoRecusa String? @map("motivo_recusa") @db.Text

  // Conversão para Pedido normal/especial
  tipoConversao String?   @map("tipo_conversao") // NORMAL | ESPECIAL | BONIFICACAO
  pedidoId      String?   @unique @map("pedido_id")
  pedido        Pedido?   @relation(fields: [pedidoId], references: [id])
  aprovadoPorId String?   @map("aprovado_por_id")
  aprovadoEm    DateTime? @map("aprovado_em")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  itens CongeladosPedidoItem[]

  @@index([status])
  @@index([congeladosClienteId])
  @@index([idempotencyKey])
  @@map("congelados_pedidos")
}

model CongeladosPedidoItem {
  id                 String           @id @default(uuid())
  congeladosPedidoId String           @map("congelados_pedido_id")
  congeladosPedido   CongeladosPedido @relation(fields: [congeladosPedidoId], references: [id], onDelete: Cascade)

  congeladosProdutoId String?            @map("congelados_produto_id")
  congeladosProduto   CongeladosProduto? @relation(fields: [congeladosProdutoId], references: [id])

  nomeProduto      String  @map("nome_produto")
  quantidade       Int // nº de caixas
  unidadesPorCaixa Int     @default(0) @map("unidades_por_caixa")
  precoUnitario    Decimal @map("preco_unitario") @db.Decimal(12, 2)

  @@map("congelados_pedido_itens")
}

// Configurações do site de congelados (chave/valor).
model CongeladosConfig {
  chave     String   @id
  valor     Json?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("congelados_config")
}

// =============================================
// FINANCEIRO — Fornecedores, Contas a Pagar e Certificado Digital
// =============================================

model Fornecedor {
  id                String   @id @default(uuid())
  contaAzulId       String?  @unique @map("conta_azul_id") // UUID da pessoa no CA (API v2 /v1/pessoas)
  cnpjCpf           String?  @map("cnpj_cpf") // só dígitos
  razaoSocial       String   @map("razao_social")
  nomeFantasia      String?  @map("nome_fantasia")
  inscricaoEstadual String?  @map("inscricao_estadual")
  email             String?
  telefone          String?
  cidade            String?
  uf                String?
  observacoes       String?  @db.Text
  ativo             Boolean  @default(true)
  origem            String   @default("APP") // APP | CA
  statusEnvioCA     String   @default("ENVIAR") @map("status_envio_ca") // ENVIAR | ENVIANDO | SINCRONIZADO | ERRO | NAO_ENVIAR
  erroEnvioCA       String?  @map("erro_envio_ca") @db.Text
  criadoEm          DateTime @default(now()) @map("criado_em")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  contasPagar  ContaPagar[]
  notasEntrada NotaEntrada[]

  @@index([cnpjCpf])
  @@index([statusEnvioCA])
  @@map("fornecedores")
}

model ContaPagar {
  id             String      @id @default(uuid())
  fornecedorId   String?     @map("fornecedor_id")
  fornecedor     Fornecedor? @relation(fields: [fornecedorId], references: [id])
  descricao      String
  categoria      String? // nome da categoria de despesa (CA)
  categoriaCaId  String?     @map("categoria_ca_id") // UUID da categoria no CA (rateio)
  numeroNota     String?     @map("numero_nota")
  chaveNfe       String?     @map("chave_nfe")
  origem         String      @default("MANUAL") // MANUAL | NFE | NFSE | IMPORTADO_CA
  // Importação do relatório "Contas a pagar" do Conta Azul (CSV). Chave natural
  // (vencimento|cnpj/nome|descrição) para não duplicar ao reimportar o mesmo mês.
  // Índice NÃO único de propósito: `prisma db push` (deploy) recusa criar UNIQUE em
  // tabela com dados sem --accept-data-loss. A dedup é feita no código (consulta o
  // hash antes de criar) — ver importacaoCaService.importar.
  hashImportacao String?     @map("hash_importacao")
  valorTotal     Decimal     @map("valor_total") @db.Decimal(12, 2)
  status         String      @default("ABERTO") // ABERTO | PARCIAL | QUITADO | CANCELADO
  competencia    DateTime?
  // Data de emissão do documento (NF: emissão da nota; manual: competência informada;
  // conciliação: data do lançamento no extrato). Fase 0 Contabilidade — sempre preenchida
  // nos caminhos novos; histórico via backfill (contabilidade-backfill-fase0).
  dataEmissao    DateTime?   @map("data_emissao")
  observacoes    String?     @db.Text
  pdfPath        String?     @map("pdf_path") @db.Text // Caminho do PDF anexado (boleto, NF, contrato…)

  // Vínculo por ID com a categoria de despesa (o campo `categoria` texto fica como legado —
  // o CA identifica categoria por nome; aqui o relatório contábil passa a ligar por FK).
  categoriaDespesaId String?           @map("categoria_despesa_id")
  categoriaDespesa   CategoriaDespesa? @relation("ContasPagarCategoria", fields: [categoriaDespesaId], references: [id], onDelete: SetNull)

  // Integração Conta Azul (POST contas-a-pagar é assíncrono: 202 + protocolo)
  idEventoCA    String? @unique @map("id_evento_ca")
  protocoloCA   String? @map("protocolo_ca")
  statusEnvioCA String  @default("NAO_ENVIAR") @map("status_envio_ca") // NAO_ENVIAR | ENVIAR | ENVIANDO | AGUARDANDO_PROTOCOLO | ENVIADO | ERRO
  erroEnvioCA   String? @map("erro_envio_ca") @db.Text

  // Condição de pagamento escolhida na entrada da nota (vai no payload da despesa ao CA:
  // metodo_pagamento + conta_financeira de cada parcela). Nulo = usa a conta padrão do CA.
  metodoPagamentoCA   String? @map("metodo_pagamento_ca") // enum de metodo_pagamento do CA
  contaFinanceiraCaId String? @map("conta_financeira_ca_id") // UUID do banco/caixa no CA
  contaFinanceira     ContaFinanceira? @relation("ContasPagarConta", fields: [contaFinanceiraCaId], references: [id], onDelete: Restrict)

  criadoPorId String?   @map("criado_por_id")
  criadoPor   Vendedor? @relation("ContasPagarCriadas", fields: [criadoPorId], references: [id])

  parcelas    ParcelaPagar[]
  rateios     ContaPagarRateio[] // Fase 2: rateio por categoria (NF-e com itens de categorias diferentes)
  notaEntrada NotaEntrada? // Fase 2: conta gerada a partir de uma NF-e capturada

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([fornecedorId])
  @@index([status])
  @@index([statusEnvioCA])
  @@index([hashImportacao])
  @@index([categoriaDespesaId])
  @@map("contas_pagar")
}

// Rateio de uma conta a pagar por categoria de despesa (CA). Uma conta com itens
// de categorias diferentes gera várias linhas; a soma dos valores = valorTotal da conta.
model ContaPagarRateio {
  id            String     @id @default(uuid())
  contaPagarId  String     @map("conta_pagar_id")
  contaPagar    ContaPagar @relation(fields: [contaPagarId], references: [id], onDelete: Cascade)
  categoria     String? // nome da categoria de despesa (CA) — legado, vínculo oficial é categoriaDespesaId
  categoriaCaId String?    @map("categoria_ca_id") // UUID da categoria no CA
  valor         Decimal    @db.Decimal(12, 2)

  categoriaDespesaId String?           @map("categoria_despesa_id")
  categoriaDespesa   CategoriaDespesa? @relation("RateiosCategoria", fields: [categoriaDespesaId], references: [id], onDelete: SetNull)

  @@index([contaPagarId])
  @@index([categoriaDespesaId])
  @@map("contas_pagar_rateio")
}

model ParcelaPagar {
  id             String     @id @default(uuid())
  contaPagarId   String     @map("conta_pagar_id")
  contaPagar     ContaPagar @relation(fields: [contaPagarId], references: [id], onDelete: Cascade)
  numeroParcela  Int        @map("numero_parcela")
  valor          Decimal    @db.Decimal(12, 2)
  dataVencimento DateTime   @map("data_vencimento")
  status         String     @default("PENDENTE") // PENDENTE | PARCIAL | PAGO | CANCELADO

  // Baixa (resumo — o detalhe fica no ledger PagamentoParcelaPagar)
  dataPagamento  DateTime? @map("data_pagamento")
  valorPago      Decimal?  @map("valor_pago") @db.Decimal(12, 2)
  formaPagamento String?   @map("forma_pagamento")
  idParcelaCA    String?   @unique @map("id_parcela_ca")
  baixadoViaCA   Boolean   @default(false) @map("baixado_via_ca")

  pagamentos      PagamentoParcelaPagar[]
  // Notas fiscais recebidas vinculadas a ESTA parcela (a NF chegou depois do lançamento).
  // Vincular NÃO cria despesa nova — só anexa o documento fiscal à parcela existente.
  notasVinculadas NotaEntradaParcela[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([contaPagarId])
  @@index([dataVencimento])
  @@index([status])
  @@map("parcelas_pagar")
}

// Ledger de pagamentos das parcelas a pagar — cada baixa (manual ou vinda do CA)
// vira uma linha; estorno marca a linha sem apagar o histórico.
model PagamentoParcelaPagar {
  id             String       @id @default(uuid())
  parcelaPagarId String       @map("parcela_pagar_id")
  parcelaPagar   ParcelaPagar @relation(fields: [parcelaPagarId], references: [id], onDelete: Cascade)
  valorPago      Decimal      @map("valor_pago") @db.Decimal(12, 2)
  juros          Decimal      @default(0) @db.Decimal(12, 2)
  multa          Decimal      @default(0) @db.Decimal(12, 2)
  desconto       Decimal      @default(0) @db.Decimal(12, 2)
  formaPagamento String?      @map("forma_pagamento")
  dataPagamento  DateTime     @map("data_pagamento")
  observacao     String?      @db.Text
  origem         String       @default("MANUAL") // MANUAL | CA | IMPORTADO_CA (baixa vinda do CSV do Conta Azul)
  idBaixaCA      String?      @unique @map("id_baixa_ca")

  // Baixa nascida "já paguei" na conferência da nota → precisa ser EMPURRADA ao CA.
  // Pagamento MANUAL comum fica NAO_ENVIAR (comportamento legado: sync é só CA→local).
  contaFinanceiraCaId String? @map("conta_financeira_ca_id") // UUID do banco/caixa no CA (de onde saiu o pgto)
  contaFinanceira     ContaFinanceira? @relation("PagamentosPagarConta", fields: [contaFinanceiraCaId], references: [id], onDelete: Restrict)
  statusEnvioCA       String  @default("NAO_ENVIAR") @map("status_envio_ca") // NAO_ENVIAR | ENVIAR | ENVIADO
  erroEnvioCA         String? @map("erro_envio_ca") @db.Text

  registradoPorId String?   @map("registrado_por_id")
  registradoPor   Vendedor? @relation("PagamentosParcelaPagarRegistrados", fields: [registradoPorId], references: [id])

  estornado      Boolean   @default(false)
  estornadoEm    DateTime? @map("estornado_em")
  estornadoPorId String?   @map("estornado_por_id")
  estornadoPor   Vendedor? @relation("PagamentosParcelaPagarEstornados", fields: [estornadoPorId], references: [id])

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([parcelaPagarId])
  @@index([dataPagamento])
  @@index([contaFinanceiraCaId])
  @@map("pagamentos_parcela_pagar")
}

// Classificação da categoria de despesa para a DRE. As categorias vêm do Conta Azul
// (nome), mas o CA não diz se é despesa de operação ou não. Aqui o usuário coloca cada
// categoria num "balde": OPERACIONAL (entra na DRE), FINANCEIRO (juros/tarifas, entra na
// DRE em linha à parte), FORA_DRE (retirada de lucros, empréstimos, imobilizado — não é
// resultado) ou A_CLASSIFICAR (recém-vista; ainda conta na DRE, mas fica sinalizada).
model CategoriaDespesa {
  id            String   @id @default(uuid())
  nome          String   @unique // nome da categoria como vem do CA/CSV
  classificacao String   @default("A_CLASSIFICAR") // OPERACIONAL | FINANCEIRO | FORA_DRE | A_CLASSIFICAR
  natureza      String   @default("A_DEFINIR") // FIXA | VARIAVEL | A_DEFINIR (fixo × variável na DRE)
  grupoDreId    String?  @map("grupo_dre_id") // bloco da DRE onde a categoria aparece
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  grupoDre GrupoDre? @relation(fields: [grupoDreId], references: [id], onDelete: SetNull)

  // Fase 0 Contabilidade: vínculos por ID (o nome continua sendo a chave de negócio p/ o CA)
  contasPagar ContaPagar[]       @relation("ContasPagarCategoria")
  rateios     ContaPagarRateio[] @relation("RateiosCategoria")
  itensNota   NotaEntradaItem[]  @relation("ItensNotaCategoria")

  @@map("categorias_despesa")
}

// Blocos configuráveis da DRE (Custos variáveis, Pessoal, Administrativas...).
// O usuário cria, renomeia e ordena; as categorias de despesa apontam para eles.
model GrupoDre {
  id           String   @id @default(uuid())
  nome         String   @unique
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  categorias CategoriaDespesa[]

  @@map("grupos_dre")
}

// Certificado digital A1 (.pfx) — arquivo salvo CRIPTOGRAFADO (AES-256-GCM) em
// uploads/certificado/; senha criptografada no banco. Captura SEFAZ = Fase 2.
model CertificadoDigital {
  id                 String    @id @default(uuid())
  titular            String
  cnpj               String
  emissor            String?
  validade           DateTime
  arquivoPath        String    @map("arquivo_path")
  senhaCriptografada String    @map("senha_criptografada") @db.Text
  ativo              Boolean   @default(true)
  instaladoEm        DateTime  @default(now()) @map("instalado_em")
  instaladoPorId     String?   @map("instalado_por_id")
  instaladoPor       Vendedor? @relation("CertificadosInstalados", fields: [instaladoPorId], references: [id])

  @@map("certificados_digitais")
}

// =============================================
// FINANCEIRO — Fase 2: Captura de NF-e (SEFAZ NFeDistribuicaoDFe) e Notas Recebidas
// =============================================

// Nota fiscal emitida CONTRA o nosso CNPJ, capturada automaticamente na SEFAZ.
// Fluxo de status: AGUARDANDO_XML (só resumo/resNFe) → NOVA (XML completo baixado)
//                  → CONFERIDA (virou conta a pagar) | VINCULADA (anexada a parcela(s)
//                    já lançada(s), SEM criar despesa nova) | ENTRADA_REGISTRADA (entrada
//                    SEM pagamento: bonificação/amostra/remessa/comodato — não gera conta
//                    a pagar) | IGNORADA | CANCELADA_EMITENTE
model NotaEntrada {
  id              String      @id @default(uuid())
  tipo            String      @default("NFE") // NFE (NFS-e = fase futura)
  chave           String      @unique // chave de acesso (44 dígitos)
  nsu             String?
  numero          String?
  serie           String?
  fornecedorCnpj  String      @map("fornecedor_cnpj") // CNPJ do emitente (só dígitos)
  fornecedorNome  String      @map("fornecedor_nome")
  fornecedorId    String?     @map("fornecedor_id")
  fornecedor      Fornecedor? @relation(fields: [fornecedorId], references: [id])
  emissao         DateTime?
  // Data em que a nota DEU ENTRADA de fato (conferida/vinculada/entrada sem pagamento).
  // Fase 0 Contabilidade: preenchida nesses três fluxos e zerada quando o registro é desfeito;
  // fica null enquanto a nota está só capturada (NOVA/AGUARDANDO_XML) ou ignorada.
  dataEntrada     DateTime?   @map("data_entrada")
  valorTotal      Decimal?    @map("valor_total") @db.Decimal(12, 2)
  status          String      @default("AGUARDANDO_XML") // AGUARDANDO_XML | NOVA | CONFERIDA | VINCULADA | ENTRADA_REGISTRADA | IGNORADA | CANCELADA_EMITENTE
  manifestada     Boolean     @default(false) // Ciência da Operação (210210) já enviada?
  infComplementar String?     @map("inf_complementar") @db.Text // infAdic/infCpl do XML (observações da nota)
  xmlPath         String?     @map("xml_path") // uploads/notas-xml/{chave}.xml
  contaPagarId    String?     @unique @map("conta_pagar_id")
  contaPagar      ContaPagar? @relation(fields: [contaPagarId], references: [id])
  dadosResumo     Json?       @map("dados_resumo") // resNFe cru (antes do XML completo chegar)
  criadoEm        DateTime    @default(now()) @map("criado_em")
  atualizadoEm    DateTime    @updatedAt @map("atualizado_em")

  // natOp do XML (ex.: "VENDA", "REMESSA EM BONIFICACAO") — base da detecção do motivo
  naturezaOperacao String? @map("natureza_operacao")

  // "Registrar entrada (sem pagamento)": nota que entra no CNPJ mas NÃO gera conta a pagar.
  motivoEntrada          String?   @map("motivo_entrada") // BONIFICACAO | AMOSTRA | REMESSA_TROCA | COMODATO | OUTRO
  observacaoEntrada      String?   @map("observacao_entrada") @db.Text
  entradaRegistradaEm    DateTime? @map("entrada_registrada_em")
  entradaRegistradaPorId String?   @map("entrada_registrada_por_id")
  entradaRegistradaPor   Vendedor? @relation("NotasEntradaRegistradas", fields: [entradaRegistradaPorId], references: [id])

  itens              NotaEntradaItem[]
  duplicatas         NotaEntradaDuplicata[]
  compras            CompraItem[] // Fase 6: entradas de estoque/custo geradas na conferência
  estoqueMovs        NotaEntradaEstoqueMov[] // ledger: entradas de estoque aplicadas por esta nota
  // Parcelas JÁ LANÇADAS às quais esta nota foi vinculada (caminho alternativo ao
  // "gerar despesa nova": a NF chegou depois do lançamento/pagamento).
  parcelasVinculadas NotaEntradaParcela[]

  @@index([status])
  @@index([fornecedorCnpj])
  @@map("notas_entrada")
}

// Vínculo N:N entre uma nota recebida e parcelas de contas a pagar JÁ existentes.
// Caso de uso: contrato de serviço com parcelas lançadas na mão; a NF de cada mês
// chega depois (às vezes depois do pagamento). Vincular anexa o documento fiscal
// à parcela — NUNCA cria despesa nova (evita duplicar a dívida).
// Uma nota pode cobrir VÁRIAS parcelas, com valor vinculado por parcela.
model NotaEntradaParcela {
  id             String       @id @default(uuid())
  notaEntradaId  String       @map("nota_entrada_id")
  notaEntrada    NotaEntrada  @relation(fields: [notaEntradaId], references: [id], onDelete: Cascade)
  parcelaPagarId String       @map("parcela_pagar_id")
  parcelaPagar   ParcelaPagar @relation(fields: [parcelaPagarId], references: [id], onDelete: Cascade)
  valorVinculado Decimal      @map("valor_vinculado") @db.Decimal(12, 2)
  // NENHUMA | AJUSTE | DESCONTO | ACRESCIMO — natureza da diferença entre o valor da
  // nota e a soma vinculada (o app pergunta ao usuário; aqui só registramos a escolha).
  tipoDiferenca  String?      @map("tipo_diferenca")
  observacao     String?      @db.Text
  criadoEm       DateTime     @default(now()) @map("criado_em")

  @@unique([notaEntradaId, parcelaPagarId])
  @@index([notaEntradaId])
  @@index([parcelaPagarId])
  @@map("nota_entrada_parcelas")
}

model NotaEntradaItem {
  id               String      @id @default(uuid())
  notaEntradaId    String      @map("nota_entrada_id")
  notaEntrada      NotaEntrada @relation(fields: [notaEntradaId], references: [id], onDelete: Cascade)
  numeroItem       Int         @map("numero_item") // nItem
  codigoFornecedor String      @map("codigo_fornecedor") // cProd
  ean              String? // cEAN (null quando "SEM GTIN")
  descricao        String // xProd
  ncm              String?
  unidade          String // uCom
  quantidade       Decimal     @db.Decimal(12, 4) // qCom
  valorUnitario    Decimal     @map("valor_unitario") @db.Decimal(12, 6) // vUnCom
  valorTotal       Decimal     @map("valor_total") @db.Decimal(12, 2) // vProd
  cfop             String? // CFOP do item (base da detecção de bonificação/amostra/remessa/comodato)
  categoria        String? // categoria de despesa (CA) efetiva escolhida na conferência — legado, vínculo oficial é categoriaDespesaId
  categoriaCaId    String?     @map("categoria_ca_id") // UUID da categoria no CA
  infAdProd        String?     @map("inf_ad_prod") @db.Text // infAdProd do item (informações adicionais)

  categoriaDespesaId String?           @map("categoria_despesa_id")
  categoriaDespesa   CategoriaDespesa? @relation("ItensNotaCategoria", fields: [categoriaDespesaId], references: [id], onDelete: SetNull)

  @@index([notaEntradaId])
  @@map("notas_entrada_itens")
}

model NotaEntradaDuplicata {
  id            String      @id @default(uuid())
  notaEntradaId String      @map("nota_entrada_id")
  notaEntrada   NotaEntrada @relation(fields: [notaEntradaId], references: [id], onDelete: Cascade)
  numero        String? // nDup
  vencimento    DateTime // dVenc
  valor         Decimal     @db.Decimal(12, 2) // vDup

  @@index([notaEntradaId])
  @@map("notas_entrada_duplicatas")
}

// De-para "produto do fornecedor → item PCP" (lembrado entre notas do mesmo fornecedor)
model FornecedorProdutoVinculo {
  id                  String   @id @default(uuid())
  fornecedorCnpj      String   @map("fornecedor_cnpj")
  codigoFornecedor    String   @map("codigo_fornecedor") // cProd na NF-e do fornecedor
  ean                 String?
  descricaoFornecedor String?  @map("descricao_fornecedor")
  unidadeFornecedor   String?  @map("unidade_fornecedor")
  itemPcpId           String?  @map("item_pcp_id") // opcional: pode memorizar só a categoria (sem vincular produto)
  itemPcp             ItemPcp? @relation(fields: [itemPcpId], references: [id])
  produtoId           String?  @map("produto_id") // opcional: vínculo com Produto do catálogo (alternativa a itemPcpId)
  produto             Produto? @relation(fields: [produtoId], references: [id])
  fatorConversao      Decimal  @default(1) @map("fator_conversao") @db.Decimal(12, 4) // 1 un do fornecedor = X unidades do item PCP
  categoria           String? // categoria de despesa (CA) memorizada para este produto do fornecedor
  categoriaCaId       String?  @map("categoria_ca_id") // UUID da categoria no CA
  atualizadoEm        DateTime @updatedAt @map("atualizado_em")

  @@unique([fornecedorCnpj, codigoFornecedor])
  @@index([itemPcpId])
  @@index([produtoId])
  @@map("fornecedor_produto_vinculos")
}

// =============================================
// FINANCEIRO — Fase 6: Compras alimentando estoque e custo
// =============================================

// Uma linha por item de nota VINCULADO a um produto/insumo na conferência.
// É o histórico de compras do produto (fornecedor, nota, quantidade, custo) e a
// base da entrada de estoque. Estornada (sem apagar) quando a entrada é cancelada.
model CompraItem {
  id            String       @id @default(uuid())
  notaEntradaId String?      @map("nota_entrada_id") // null = compra lançada numa despesa MANUAL (sem NF-e)
  notaEntrada   NotaEntrada? @relation(fields: [notaEntradaId], references: [id])
  contaPagarId  String?      @map("conta_pagar_id")

  // Alvo do vínculo: Produto do catálogo OU insumo PCP (exatamente um)
  produtoId String?  @map("produto_id")
  produto   Produto? @relation(fields: [produtoId], references: [id])
  itemPcpId String?  @map("item_pcp_id")
  itemPcp   ItemPcp? @relation(fields: [itemPcpId], references: [id])

  fornecedorId   String?  @map("fornecedor_id")
  fornecedorNome String   @map("fornecedor_nome")
  fornecedorCnpj String?  @map("fornecedor_cnpj")
  numeroNota     String?  @map("numero_nota")
  dataCompra     DateTime @map("data_compra") // emissão da nota

  descricaoFornecedor  String  @map("descricao_fornecedor") // xProd na nota
  quantidadeFornecedor Decimal @map("quantidade_fornecedor") @db.Decimal(12, 4) // na unidade da nota
  unidadeFornecedor    String  @map("unidade_fornecedor")
  fatorConversao       Decimal @default(1) @map("fator_conversao") @db.Decimal(12, 4)
  quantidade           Decimal @db.Decimal(12, 3) // convertida para a NOSSA unidade
  unidade              String // nossa unidade
  valorTotal           Decimal @map("valor_total") @db.Decimal(12, 2)
  custoUnitario        Decimal @map("custo_unitario") @db.Decimal(12, 6) // valorTotal / quantidade convertida

  // Retrato do alvo ANTES/DEPOIS desta compra (08/2026) — é o que permite ao estorno
  // devolver o custo exato de antes, em vez de tentar adivinhar pelo replay.
  // NULL nas linhas antigas (sem backfill: não existe fonte confiável) → nesses casos
  // o estorno cai no replay das compras válidas, como sempre foi.
  estoqueAnterior Decimal? @map("estoque_anterior") @db.Decimal(12, 3) // saldo do produto/insumo antes desta entrada
  custoAnterior   Decimal? @map("custo_anterior") @db.Decimal(12, 6) // custoManual (Produto) / custoUnitario (ItemPcp) antes
  custoPosterior  Decimal? @map("custo_posterior") @db.Decimal(12, 6) // o que esta compra deixou gravado no alvo

  estornado   Boolean   @default(false) // entrada cancelada (cancelar-conferência)
  estornadoEm DateTime? @map("estornado_em")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([produtoId])
  @@index([itemPcpId])
  @@index([notaEntradaId])
  @@index([contaPagarId])
  @@map("compras_itens")
}

// Ledger das entradas de ESTOQUE aplicadas por uma nota recebida (decisão do dono
// em 07/2026: TODA nota conferida soma no estoque — tanto "gerar conta a pagar"
// quanto "registrar entrada sem pagamento"). Uma linha por item aplicado, com a
// quantidade já convertida e o custo antes/depois — é o que permite estornar com
// segurança (cancelar conferência / desfazer entrada) sem aplicar nem tirar em dobro.
model NotaEntradaEstoqueMov {
  id                String      @id @default(uuid())
  notaEntradaId     String      @map("nota_entrada_id")
  notaEntrada       NotaEntrada @relation(fields: [notaEntradaId], references: [id], onDelete: Cascade)
  notaEntradaItemId String?     @map("nota_entrada_item_id")

  destino   String // PROD (Produto do catálogo) | PCP (insumo ItemPcp)
  produtoId String?  @map("produto_id")
  produto   Produto? @relation(fields: [produtoId], references: [id])
  itemPcpId String?  @map("item_pcp_id")
  itemPcp   ItemPcp? @relation(fields: [itemPcpId], references: [id])

  quantidade    Decimal  @db.Decimal(12, 4) // já convertida para a NOSSA unidade (qtd da nota × fator)
  custoUnitario Decimal? @map("custo_unitario") @db.Decimal(12, 6) // custo da compra por unidade convertida; null = entrada sem pagamento (bonificação etc.)

  // Custo do alvo antes/depois da média ponderada (null quando o custo não foi tocado)
  custoAnterior  Decimal? @map("custo_anterior") @db.Decimal(12, 6)
  custoPosterior Decimal? @map("custo_posterior") @db.Decimal(12, 6)

  estornado   Boolean   @default(false)
  estornadoEm DateTime? @map("estornado_em")
  criadoEm    DateTime  @default(now()) @map("criado_em")

  @@index([notaEntradaId])
  @@map("nota_entrada_estoque_movs")
}

// =============================================
// FINANCEIRO — Conciliação bancária (extrato OFX)
// =============================================

// Uma importação de arquivo OFX de extrato bancário (histórico de uploads).
model ExtratoImportacao {
  id                  String    @id @default(uuid())
  contaFinanceiraCaId String    @map("conta_financeira_ca_id") // banco/caixa (UUID da conta no CA)
  contaFinanceira     ContaFinanceira @relation("ExtratoImportacoesConta", fields: [contaFinanceiraCaId], references: [id], onDelete: Restrict)
  nomeArquivo         String    @map("nome_arquivo")
  dataInicio          DateTime? @map("data_inicio") // menor data dos lançamentos do arquivo
  dataFim             DateTime? @map("data_fim")
  totalArquivo        Int       @default(0) @map("total_arquivo") // lançamentos no arquivo
  novos               Int       @default(0) // gravados (não existiam ainda)
  duplicados          Int       @default(0) // já existiam (FITID repetido) — pulados
  criadoPorId         String?   @map("criado_por_id")
  criadoEm            DateTime  @default(now()) @map("criado_em")

  // IDENTIDADE DO ARQUIVO — de qual banco/conta o extrato é (tags do próprio OFX).
  // É a TRAVA contra importar na conta errada: cada conta "aprende" sua identidade na
  // primeira importação e recusa arquivo de outra conta depois disso. (Em 29/07/2026 o
  // OFX da Conta PJ do Conta Azul entrou no Sicoob e sujou o extrato com 326 linhas.)
  bankId      String? @map("bank_id") // <BANKID> — código do banco
  acctId      String? @map("acct_id") // <ACCTID> — número da conta
  orgArquivo  String? @map("org_arquivo") // <FI><ORG> — quem gerou o arquivo
  hashArquivo String? @map("hash_arquivo") // SHA-256 do arquivo (mesmo arquivo em 2 contas)

  lancamentos ExtratoLancamento[]

  @@index([contaFinanceiraCaId])
  @@index([acctId])
  @@map("extrato_importacoes")
}

// Um lançamento do extrato do banco (uma linha do OFX).
// FITID é a identidade do lançamento no banco → unique por conta = importação idempotente.
model ExtratoLancamento {
  id                  String            @id @default(uuid())
  importacaoId        String            @map("importacao_id")
  importacao          ExtratoImportacao @relation(fields: [importacaoId], references: [id])
  contaFinanceiraCaId String            @map("conta_financeira_ca_id")
  contaFinanceira     ContaFinanceira   @relation("ExtratoLancamentosConta", fields: [contaFinanceiraCaId], references: [id], onDelete: Restrict)
  fitId               String            @map("fit_id")
  data                DateTime
  valor               Decimal           @db.Decimal(12, 2) // sempre positivo; o sentido fica no tipo
  tipo                String // CREDITO (entrou) | DEBITO (saiu)
  descricao           String?           @db.Text // o que aparece na tela (MEMO, ou NAME quando não há MEMO)

  // Campos crus do OFX. O banco manda mais coisa que o MEMO ("DÉB.TIT.COMPE EFETIVADO" não
  // diz nada sozinho): dependendo do banco, o beneficiário vem no NAME ou no bloco PAYEE, e o
  // nº do documento no CHECKNUM. Guardamos tudo para dar pistas de "do que se trata".
  memo     String? @db.Text
  nome     String? @db.Text // <NAME> — em vários bancos é o beneficiário/pagador
  payee    String? @db.Text // bloco <PAYEE><NAME>
  checkNum String? @map("check_num") // <CHECKNUM> — nº do documento/boleto
  refNum   String? @map("ref_num") // <REFNUM>
  trnType  String? @map("trn_type") // DEBIT | CREDIT | XFER | PAYMENT | FEE…

  status String @default("PENDENTE") // PENDENTE | CONCILIADO | IGNORADO

  // Vínculo com o lançamento do app quando CONCILIADO (exatamente um dos dois):
  pagamentoParcelaId      String?   @map("pagamento_parcela_id") // entrada — baixa de contas a receber
  pagamentoParcelaPagarId String?   @map("pagamento_parcela_pagar_id") // saída — baixa de contas a pagar
  conciliadoAuto          Boolean   @default(false) @map("conciliado_auto")
  conciliadoPorId         String?   @map("conciliado_por_id")
  conciliadoEm            DateTime? @map("conciliado_em")
  obs                     String? // motivo do "ignorar" (tarifa, transferência interna...)

  @@unique([contaFinanceiraCaId, fitId])
  @@index([status])
  @@index([contaFinanceiraCaId, data])
  @@index([pagamentoParcelaId])
  @@index([pagamentoParcelaPagarId])
  @@map("extrato_lancamentos")
}

// Conciliação em GRUPO: N lançamentos do extrato ↔ M baixas do app (soma exata).
// Cobre 1 PIX pagando várias notas, 2 PIX pagando uma baixa, e PIX parcial
// (baixa parcial no app + saldo em outro grupo). O caso simples 1↔1 continua
// nos campos pagamentoParcelaId/pagamentoParcelaPagarId do ExtratoLancamento.
model ConciliacaoGrupo {
  id                  String  @id @default(uuid())
  contaFinanceiraCaId String  @map("conta_financeira_ca_id")
  contaFinanceira     ContaFinanceira @relation("ConciliacaoGruposConta", fields: [contaFinanceiraCaId], references: [id], onDelete: Restrict)
  tipo                String // CREDITO | DEBITO (um grupo não mistura sentidos)
  valor               Decimal @db.Decimal(12, 2) // soma do lado do EXTRATO (legado: antes, os dois lados eram iguais)

  // Os dois lados podem NÃO fechar (tarifa do banco, juros pagos a mais, desconto…).
  // Nesse caso o grupo só é aceito com o motivo declarado — a diferença fica registrada,
  // nunca "some" no arredondamento.
  valorBaixas     Decimal @default(0) @map("valor_baixas") @db.Decimal(12, 2)
  diferenca       Decimal @default(0) @db.Decimal(12, 2) // extrato − baixas (pode ser negativo)
  motivoDiferenca String? @map("motivo_diferenca")

  criadoPorId String?  @map("criado_por_id")
  criadoEm    DateTime @default(now()) @map("criado_em")

  itens ConciliacaoGrupoItem[]

  @@index([contaFinanceiraCaId])
  @@map("conciliacao_grupos")
}

// Transferência entre contas da PRÓPRIA empresa (mesma titularidade) — não é
// receita nem despesa. Nasce na conciliação bancária ("PIX OUTRA IF - MESMA TIT.")
// pelo botão "Transferência entre contas". Aparece nos relatórios POR CONTA
// (Saldos por Conta / extrato) como movimento próprio: sai de uma, entra na outra.
// NUNCA entra na DRE nem no fluxo de caixa gerencial (no global soma zero).
model TransferenciaConta {
  id             String   @id @default(uuid())
  data           DateTime
  valor          Decimal  @db.Decimal(12, 2) // sempre positivo
  contaOrigemId  String?  @map("conta_origem_id") // UUID da conta financeira no CA; null = conta fora do sistema
  contaOrigem    ContaFinanceira? @relation("TransferenciasOrigem", fields: [contaOrigemId], references: [id], onDelete: Restrict)
  contaDestinoId String?  @map("conta_destino_id") // idem
  contaDestino   ContaFinanceira? @relation("TransferenciasDestino", fields: [contaDestinoId], references: [id], onDelete: Restrict)
  descricao      String?

  // Lançamento do extrato que originou (conciliação); null = lançada à mão
  extratoLancamentoId String? @unique @map("extrato_lancamento_id")

  // Transferência importada do Conta Azul (id dela lá) — idempotência do sync
  // (conferida no código; SEM @unique de propósito: constraint nova travaria o
  // `prisma db push` do deploy pedindo --accept-data-loss).
  // null = lançada à mão no app ou via conciliação
  idTransferenciaCA String? @map("id_transferencia_ca")

  criadoPorId String?   @map("criado_por_id")
  criadoPor   Vendedor? @relation("TransferenciasContaCriadas", fields: [criadoPorId], references: [id])
  criadoEm    DateTime  @default(now()) @map("criado_em")

  @@index([contaOrigemId, data])
  @@index([contaDestinoId, data])
  @@index([idTransferenciaCA])
  @@map("transferencias_conta")
}

// Item de um grupo: OU um lançamento do extrato, OU uma baixa do app (exatamente um).
// Uniques garantem que cada lançamento/baixa participa de no máximo um grupo.
model ConciliacaoGrupoItem {
  id      String           @id @default(uuid())
  grupoId String           @map("grupo_id")
  grupo   ConciliacaoGrupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  extratoLancamentoId     String? @unique @map("extrato_lancamento_id")
  pagamentoParcelaId      String? @unique @map("pagamento_parcela_id")
  pagamentoParcelaPagarId String? @unique @map("pagamento_parcela_pagar_id")

  @@index([grupoId])
  @@map("conciliacao_grupo_itens")
}

// ═══════════════ RÉGUA DE COBRANÇA (inadimplentes) ═══════════════
// Uma configuração por forma de recebimento (nome da condição de pagamento do pedido).
// A linha especial forma_recebimento = 'PADRAO' vale para qualquer parcela cuja
// condição não tenha configuração própria (inclui contas importadas do CA sem pedido).
model CobrancaConfig {
  id               String  @id @default(uuid())
  formaRecebimento String  @unique @map("forma_recebimento")
  ativo            Boolean @default(true)

  // Régua (dias sempre relativos ao vencimento da parcela)
  diasPrimeiroAviso Int     @default(1) @map("dias_primeiro_aviso") // 1º aviso: X dias APÓS vencer
  repetirCadaDias   Int     @default(7) @map("repetir_cada_dias") // frequência dos avisos seguintes
  maxAvisos         Int     @default(5) @map("max_avisos") // teto de avisos automáticos por dívida
  enviarVencida     Boolean @default(true) @map("enviar_vencida") // false = não cobra vencidas (só lembrete)
  lembreteAntes     Boolean @default(false) @map("lembrete_antes") // lembrete ANTES de vencer
  diasLembrete      Int     @default(3) @map("dias_lembrete") // quantos dias antes do vencimento

  // Horário próprio de disparo (HH:MM, São Paulo); null = usa o horário geral
  horaEnvio         String? @map("hora_envio")
  // 'YYYY-MM-DD' do último disparo automático (evita rodar 2x no mesmo dia)
  ultimaExecucaoDia String? @map("ultima_execucao_dia")

  // Canais de envio
  canalWhatsapp Boolean @default(true) @map("canal_whatsapp")
  canalEmail    Boolean @default(false) @map("canal_email")
  canalSms      Boolean @default(false) @map("canal_sms")

  // Mensagens: [{ nome, texto }] — o aviso nº N usa o template N (o último repete).
  // Placeholders: {nome} {valor_total} {parcelas} {qtd_parcelas} {dias_atraso} {vencimento}
  templates        Json?
  templateLembrete String? @map("template_lembrete") @db.Text

  // Quem recebe a TAREFA quando o envio de WhatsApp falha (sem celular / bot recusou)
  responsavelTarefaId String?   @map("responsavel_tarefa_id")
  responsavelTarefa   Vendedor? @relation("CobrancaResponsavelTarefa", fields: [responsavelTarefaId], references: [id])

  envios CobrancaEnvio[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cobranca_configs")
}

// Log de cada tentativa de envio de cobrança (um registro por cliente+canal por disparo)
model CobrancaEnvio {
  id        String          @id @default(uuid())
  clienteId String          @map("cliente_id")
  cliente   Cliente         @relation(fields: [clienteId], references: [UUID])
  configId  String?         @map("config_id")
  config    CobrancaConfig? @relation(fields: [configId], references: [id])

  tipo        String  @default("COBRANCA") // COBRANCA | LEMBRETE | MANUAL
  canal       String // WHATSAPP | EMAIL | SMS
  destino     String? // telefone/e-mail/número usado no envio
  status      String // ENVIADO | ERRO
  erro        String? @db.Text
  mensagem    String? @db.Text // texto enviado (auditoria)
  numeroAviso Int     @default(1) @map("numero_aviso")
  parcelas    Json? // snapshot [{ parcelaId, numero, valor, vencimento }]
  valorTotal  Decimal @default(0) @map("valor_total") @db.Decimal(12, 2)
  tarefaId    String? @map("tarefa_id") // tarefa criada por causa da falha (se houve)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([clienteId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@map("cobranca_envios")
}

// Singleton de controle da distribuição DF-e (último NSU consumido, bloqueio 656, etc.)
model DfeControle {
  id              String    @id @default("dfe")
  ultNSU          String    @default("0") @map("ult_nsu")
  maxNSU          String?   @map("max_nsu")
  ultimaConsulta  DateTime? @map("ultima_consulta")
  ultimoResultado String?   @map("ultimo_resultado") @db.Text
  bloqueadoAte    DateTime? @map("bloqueado_ate") // cStat 656 (consumo indevido) → 1h15 sem consultar
  totalCapturadas Int       @default(0) @map("total_capturadas")

  @@map("dfe_controle")
}

// Fila de buscas por chave agendadas (quando a SEFAZ está no intervalo de espera).
// O worker processa uma por vez, respeitando a trava de ~1 consulta por hora.
model NotaBuscaAgendada {
  id           String    @id @default(uuid())
  chave        String
  status       String    @default("PENDENTE") // PENDENTE | CONCLUIDA | FALHOU
  tentativas   Int       @default(0)
  resultado    String?   @db.Text
  criadoPorId  String?   @map("criado_por_id")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  processadoEm DateTime? @map("processado_em")

  @@index([status])
  @@map("notas_busca_agendada")
}

// =============================================
// CATÁLOGO PERSONALIZADO
// Lista de preços montada pelo vendedor para um cliente/condição, compartilhável por
// link público (/lista/<token>). É um SNAPSHOT: os preços ficam congelados no momento
// da geração — se o produto mudar de preço depois, o link que o cliente já recebeu não muda.
// Aditivo por design: guarda clienteUuid/produtoId como IDs soltos (sem FK, igual
// Condicao_de_pagamento), então não altera os models Cliente/Produto.
// =============================================
model CatalogoPersonalizado {
  id                String    @id @default(uuid())
  token             String    @unique // token curto p/ a URL pública: /lista/<token>
  titulo            String? // opcional (ex.: "Lista de agosto")
  clienteUuid       String?   @map("cliente_uuid") // null = destinatário avulso (não-cliente); sem FK (snapshot)
  clienteNome       String    @map("cliente_nome") // nome do cliente OU do destinatário avulso
  clienteTelefone   String?   @map("cliente_telefone")
  clienteCidade     String?   @map("cliente_cidade")
  condicaoId        String    @map("condicao_id") // TabelaPreco.id no momento
  condicaoNome      String    @map("condicao_nome")
  medianteAprovacao Boolean   @default(false) @map("mediante_aprovacao") // condição c/ prazo não aprovada p/ o destinatário
  acrescimoPreco    Decimal   @default(0) @map("acrescimo_preco") @db.Decimal(10, 2)
  valorMinimo       Decimal?  @default(0) @map("valor_minimo") @db.Decimal(12, 2)
  total             Decimal   @default(0) @db.Decimal(12, 2) // soma dos precoFinal (snapshot)
  validadeEm        DateTime? @map("validade_em") // null = sem validade
  observacoes       String?   @db.Text
  status            String    @default("ATIVO") // ATIVO | REMOVIDO
  vendedorId        String?   @map("vendedor_id")
  vendedorNome      String?   @map("vendedor_nome")
  vendedorTelefone  String?   @map("vendedor_telefone")
  visualizacoes     Int       @default(0)
  ultimaVisita      DateTime? @map("ultima_visita")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  itens CatalogoPersonalizadoItem[]

  @@index([token])
  @@index([clienteUuid])
  @@index([vendedorId])
  @@map("catalogos_personalizados")
}

model CatalogoPersonalizadoItem {
  id            String  @id @default(uuid())
  catalogoId    String  @map("catalogo_id")
  produtoId     String  @map("produto_id") // sem FK (snapshot)
  codigo        String
  nome          String
  unidade       String
  imagemUrl     String? @map("imagem_url")
  valorBase     Decimal @map("valor_base") @db.Decimal(12, 2) // valorVenda no momento da geração
  precoFinal    Decimal @map("preco_final") @db.Decimal(12, 2) // valorVenda * (1 + acrescimoPreco/100)
  categoriaNome String? @map("categoria_nome")
  categoriaCor  String? @map("categoria_cor")
  ordem         Int     @default(0)

  catalogo CatalogoPersonalizado @relation(fields: [catalogoId], references: [id], onDelete: Cascade)

  @@index([catalogoId])
  @@map("catalogos_personalizados_itens")
}

// =============================================
// INTEGRAÇÃO ASAAS (PIX / Boleto emitidos pelo app)
// =============================================

// Vínculo 1-1 cliente ↔ customer no Asaas.
// Tabela separada (padrão ClienteFiscal): a tabela `clientes` está no teto de colunas do Postgres.
model ClienteAsaas {
  clienteUuid     String   @id @map("cliente_uuid")
  asaasCustomerId String   @unique @map("asaas_customer_id")
  ambiente        String   @default("PRODUCAO") // PRODUCAO | SANDBOX
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  cliente Cliente @relation(fields: [clienteUuid], references: [UUID], onDelete: Cascade)

  @@map("clientes_asaas")
}

// Cada cobrança criada no Asaas pelo app (QR Code PIX na entrega, boleto etc.)
model CobrancaAsaas {
  id             String  @id @default(uuid())
  asaasPaymentId String  @unique @map("asaas_payment_id")
  tipo           String  @default("PIX") // PIX | BOLETO
  status         String  @default("PENDENTE") // PENDENTE | RECEBIDO | CANCELADO | EXPIRADO
  valor          Decimal @db.Decimal(12, 2)
  descricao      String? @db.Text

  clienteId String   @map("cliente_id")
  cliente   Cliente  @relation(fields: [clienteId], references: [UUID])
  pedidoId  String?  @map("pedido_id")
  pedido    Pedido?  @relation(fields: [pedidoId], references: [id])
  parcelaId String?  @map("parcela_id")
  parcela   Parcela? @relation(fields: [parcelaId], references: [id])

  // PIX
  pixPayload      String?   @map("pix_payload") @db.Text // código copia-e-cola
  pixQrCodeBase64 String?   @map("pix_qrcode_base64") @db.Text
  pixExpiraEm     DateTime? @map("pix_expira_em")

  // Boleto (fase 2)
  boletoUrl      String?   @map("boleto_url")
  linhaDigitavel String?   @map("linha_digitavel")
  vencimento     DateTime?

  // Recebimento (via webhook do Asaas)
  recebidoEm    DateTime? @map("recebido_em")
  valorRecebido Decimal?  @map("valor_recebido") @db.Decimal(12, 2)
  baixaAppOk    Boolean   @default(false) @map("baixa_app_ok") // baixa da parcela local registrada
  baixaCaOk     Boolean   @default(false) @map("baixa_ca_ok") // baixa registrada no Conta Azul
  estornoOk     Boolean   @default(false) @map("estorno_ok") // devolução já processada (idempotência)
  baixaErro     String?   @map("baixa_erro") @db.Text

  criadoPorId String?   @map("criado_por_id")
  criadoPor   Vendedor? @relation("CobrancasAsaasCriadas", fields: [criadoPorId], references: [id])
  ambiente    String    @default("PRODUCAO") // PRODUCAO | SANDBOX

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([pedidoId])
  @@index([parcelaId])
  @@index([clienteId])
  @@index([status])
  @@map("cobrancas_asaas")
}

// Pedido especial que virou pedido com NF (pago via PIX Asaas) — alimenta o
// popup do faturamento (a cada 5 min até alguém dar ciência).
model PedidoConvertidoAviso {
  id           String    @id @default(uuid())
  pedidoId     String    @map("pedido_id")
  pedido       Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  numeroAntigo Int?      @map("numero_antigo") // ZZ# antes da conversão
  numeroNovo   Int?      @map("numero_novo") // # na sequência normal
  valorPago    Decimal?  @map("valor_pago") @db.Decimal(12, 2)
  cienteEm     DateTime? @map("ciente_em")
  cientePorId  String?   @map("ciente_por_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([cienteEm])
  @@map("pedidos_convertidos_avisos")
}

// Log bruto dos webhooks recebidos do Asaas (auditoria + idempotência)
model AsaasWebhookEvento {
  id         String   @id @default(uuid())
  eventoId   String?  @unique @map("evento_id") // id do evento no Asaas (evita processar 2x)
  evento     String // PAYMENT_RECEIVED, PAYMENT_CONFIRMED, ...
  paymentId  String?  @map("payment_id")
  payload    Json
  processado Boolean  @default(false)
  erro       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([paymentId])
  @@map("asaas_webhook_eventos")
}

// ============================================================================
// ARQUIVO das contas a receber importadas do Conta Azul (23/07/2026 — o app
// virou o dono do financeiro; o CA é somente leitura e pode sumir a qualquer
// momento). Uma linha POR PARCELA do CA, com os JSONs crus completos (busca +
// detalhe com evento/baixas) para nunca perder informação. A camada operacional
// (ContaReceber/Parcela) é criada à parte pelo importador quando a conta está
// em aberto e não existe no app.
// ============================================================================
model CaReceberImportado {
  id              String    @id @default(uuid())
  idParcelaCA     String    @unique @map("id_parcela_ca")
  idEventoCA      String?   @map("id_evento_ca")
  clienteCaId     String?   @map("cliente_ca_id")
  clienteNome     String?   @map("cliente_nome")
  descricao       String?
  numeroVendaCA   Int?      @map("numero_venda_ca") // evento.codigo_referencia → casa com pedido.numero
  origemEventoCA  String?   @map("origem_evento_ca") // VENDA | AVULSA | ...
  status          String? // status_traduzido do CA (RECEBIDO/PENDENTE/ATRASADO...)
  dataVencimento  DateTime? @map("data_vencimento")
  dataCompetencia DateTime? @map("data_competencia")
  valorTotal      Decimal?  @map("valor_total") @db.Decimal(12, 2)
  valorPago       Decimal?  @map("valor_pago") @db.Decimal(12, 2)
  temPedidoApp    Boolean   @default(false) @map("tem_pedido_app")
  contaReceberId  String?   @map("conta_receber_id") // ContaReceber operacional criada p/ esta parcela (quando aberta e sem pedido)
  parcelaLocalId  String?   @map("parcela_local_id")
  dadosBusca      Json?     @map("dados_busca") // item cru do /contas-a-receber/buscar
  dadosDetalhe    Json?     @map("dados_detalhe") // detalhe cru da parcela (evento, baixas, conta financeira...)
  importadoEm     DateTime  @default(now()) @map("importado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  @@index([numeroVendaCA])
  @@index([status])
  @@index([clienteCaId])
  @@map("ca_receber_importado")
}
