// NF-e emitida pelo próprio app via Focus NFe (substitui a emissão no Conta Azul,
// que bloqueou o acesso em 07/2026). `ref` é a idempotência na Focus: rejeitada
// reenvia com a MESMA ref; autorizada prende a ref para sempre.
model NotaFiscalApp {
  id             String  @id @default(uuid())
  ref            String  @unique
  ambiente       String // homologacao | producao
  tipo           String  @default("VENDA") // VENDA | DEVOLUCAO
  status         String  @default("PROCESSANDO") // PROCESSANDO | AUTORIZADO | ERRO | CANCELADO | DENEGADO
  numero         Int?
  serie          Int?
  chave          String?
  mensagemSefaz  String? @map("mensagem_sefaz") @db.Text
  caminhoXml     String? @map("caminho_xml")
  caminhoDanfe   String? @map("caminho_danfe")
  payloadEnviado Json?   @map("payload_enviado") // JSON mandado à Focus (auditoria/reemissão)

  pedidoId String @map("pedido_id")
  pedido   Pedido @relation(fields: [pedidoId], references: [id])

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  canhoto CanhotoNota? // controle do canhoto assinado desta nota

  @@index([pedidoId])
  @@index([status])
  @@map("notas_fiscais_app")
}

// CANHOTO DA NOTA FISCAL (08/2026)
// O canhoto assinado é a prova de entrega — sem ele não há protesto. Cada NF-e de
// venda autorizada nasce aqui com status AGUARDANDO; o escritório bipa o código de
// barras da DANFE na volta do motorista e a nota vira RECEBIDO → ARQUIVADO.
// A `chave` é @unique DE PROPÓSITO: é ela que torna o bipe repetido do mutirão
// idempotente no banco, não no código.
model CanhotoNota {
  id     String @id @default(uuid())
  chave  String @unique // 44 dígitos da chave de acesso
  numero Int? // nNF (posições 25..33 da chave)
  serie  Int?

  origem String @default("APP") // APP (Focus) | CA (nota antiga do Conta Azul)
  tipo   String @default("VENDA") // VENDA | DEVOLUCAO — devolução só arquiva, nunca pede assinatura

  pedidoId  String         @map("pedido_id")
  pedido    Pedido         @relation(fields: [pedidoId], references: [id])
  notaAppId String?        @unique @map("nota_app_id")
  notaApp   NotaFiscalApp? @relation(fields: [notaAppId], references: [id])

  // ⏳ Na rua | ✓ Recebido | 🗄 Arquivado | ✎ Sem assinatura | ✕ Sem canhoto | ? Desconhecido (mutirão)
  status String @default("AGUARDANDO")

  // AGUARDANDO | DESCONHECIDO | RECEBIDO | ARQUIVADO | SEM_ASSINATURA | SEM_CANHOTO

  // Snapshots — a aba Canhotos lista SEM join (é o que a mantém rápida)
  clienteNome String?  @map("cliente_nome")
  valorTotal  Decimal? @map("valor_total") @db.Decimal(12, 2)
  emitidaEm   DateTime @map("emitida_em")
  competencia String   @map("competencia") // "2026-08" — filtro do mês
  pastaFisica String   @map("pasta_fisica") // "Notas Emitidas Agosto 2026" (preenchido sozinho)

  // Quem levou (snapshot no momento do registro; "na rua" é derivado disto)
  embarqueId    String?   @map("embarque_id")
  motoristaId   String?   @map("motorista_id")
  motoristaNome String?   @map("motorista_nome")
  saiuEm        DateTime? @map("saiu_em") // embarque.dataSaida — base do alerta de 3 dias

  // Bipe
  recebidoPorId   String?      @map("recebido_por_id")
  recebidoPorNome String?      @map("recebido_por_nome")
  recebidoEm      DateTime?    @map("recebido_em")
  recebidoOrigem  String?      @map("recebido_origem") // LEITOR | CAMERA | NUMERO | MUTIRAO
  caixaDiarioId   String?      @map("caixa_diario_id") // em qual caixa o bipe aconteceu (auditoria)
  caixaDiario     CaixaDiario? @relation(fields: [caixaDiarioId], references: [id])

  // Arquivamento
  arquivadoPorId   String?   @map("arquivado_por_id")
  arquivadoPorNome String?   @map("arquivado_por_nome")
  arquivadoEm      DateTime? @map("arquivado_em")

  // Liberação sem canhoto (motivo FECHADO + senha)
  motivoLiberacao String?   @map("motivo_liberacao")
  liberadoPorId   String?   @map("liberado_por_id")
  liberadoPorNome String?   @map("liberado_por_nome")
  liberadoEm      DateTime? @map("liberado_em")
  // "Volta amanhã": libera o caixa de hoje mas a nota CONTINUA na fila de pendências
  voltaAmanha     Boolean   @default(false) @map("volta_amanha")

  // DESFAZER (um nível só) — bipar/arquivar/sem-assinatura gravam aqui de onde a nota
  // saiu; o Desfazer devolve a ela, apaga `statusAnterior` e carimba `desfeitoEm`.
  // É `desfeitoEm` (não `statusAnterior`) que impede desfazer duas vezes seguidas:
  // qualquer passo novo dado por gente limpa o carimbo e libera um Desfazer de novo.
  // Linha gravada ANTES desta mudança tem `statusAnterior` null e cai no estado de
  // nascimento (mesma regra do registro/backfill) — ver `estadoDeNascimento`.
  statusAnterior  String?   @map("status_anterior")
  desfeitoPorId   String?   @map("desfeito_por_id")
  desfeitoPorNome String?   @map("desfeito_por_nome")
  desfeitoEm      DateTime? @map("desfeito_em")

  observacao String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  // `emitidaEm` é o filtro de TODA consulta do período (lista, groupBy, contadores,
  // alerta). Sem ele a aba faria seq scan da tabela inteira a cada carga.
  @@index([emitidaEm])
  // `competencia` vem do AAMM da própria chave = o mês da PASTA FÍSICA. É por onde se
  // pergunta "em que pasta está esta nota" — dimensão diferente de `emitidaEm`.
  @@index([competencia, status])
  @@index([pedidoId])
  @@index([numero])
  @@index([motoristaId, saiuEm])
  @@map("canhotos_nota")
}

model AppConfig {
  key   String @id
  value Json

  @@map("app_configs")
}

// Evento recebido pelo webhook da Focus NFe (mudança de status de documento
// fiscal: autorizado, erro_autorizacao, cancelado...). Guardamos tudo que chega;
// o módulo de emissão consome depois marcando `processado`.
model FocusNfeEvento {
  id            Int      @id @default(autoincrement())
  evento        String   @default("nfe") // tipo do gatilho na Focus (nfe, nfse, ...)
  ref           String? // nossa referência do documento na Focus
  cnpjEmitente  String?  @map("cnpj_emitente")
  status        String? // autorizado | erro_autorizacao | cancelado | processando_autorizacao...
  statusSefaz   String?  @map("status_sefaz")
  mensagemSefaz String?  @map("mensagem_sefaz")
  chaveNfe      String?  @map("chave_nfe")
  numero        String?
  serie         String?
  payload       Json // corpo completo recebido, como veio
  processado    Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([ref])
  @@index([processado])
  @@index([createdAt])
  @@map("focus_nfe_eventos")
}

// ─────────────────────────────────────────────────────────────────────────────
// RH — Ponto eletrônico e cadastro de funcionário
// ─────────────────────────────────────────────────────────────────────────────

// Funcionário: entidade central do RH. Pode ser ativado a partir de um Cliente
// (clienteUuid) e/ou vinculado a um usuário do app (vendedorId).
model Funcionario {
  id           String    @id @default(uuid())
  nome         String
  cpf          String?   @unique
  telefone     String?
  email        String?
  endereco     String?
  foto         String?
  cargo        String?
  dataAdmissao DateTime? @map("data_admissao")
  dataDemissao DateTime? @map("data_demissao")
  salario      Decimal   @default(0) @map("salario") @db.Decimal(12, 2)

  // Regras de jornada/folha
  tipoHoraExtra String  @default("BANCO") @map("tipo_hora_extra") // BANCO | PAGA
  jornadaMovel  Boolean @default(true) @map("jornada_movel") // desloca mantendo a carga

  // CLT = salário mensal, jornada, falta, DSR · PRESTADOR = só horas × valor da hora
  tipoContrato String  @default("CLT") @map("tipo_contrato")
  valorHora    Decimal @default(0) @map("valor_hora") @db.Decimal(10, 2)

  // Parâmetros do cálculo da folha
  percentualHoraExtra Decimal @default(50) @map("percentual_hora_extra") @db.Decimal(5, 2) // adicional da hora extra (%)
  divisorHoras        Int     @default(220) @map("divisor_horas") // divisor do salário p/ achar o valor da hora
  descontarDsrFalta   Boolean @default(true) @map("descontar_dsr_falta") // falta injustificada faz perder o DSR da semana

  // Onde a pessoa registra o ponto:
  // APP = link pessoal · RELOGIO = equipamento da empresa (batidas entram por
  // importação) · NAO_REGISTRA = não bate ponto (sai de todos os alertas)
  registraPontoEm String @default("APP") @map("registra_ponto_em")

  // Link pessoal de ponto (token permanente)
  pontoToken String? @unique @map("ponto_token")
  // Senha de acesso ao link de ponto (bcrypt). Sem senha = acesso não liberado.
  senhaHash  String? @map("senha_hash")

  ativo      Boolean @default(true)
  observacao String? @db.Text

  // Origem da pessoa (cadastro de cliente) — 1-1
  clienteUuid String?  @unique @map("cliente_uuid")
  cliente     Cliente? @relation(fields: [clienteUuid], references: [UUID])

  // Vínculo opcional com usuário do app
  vendedorId String?   @map("vendedor_id")
  vendedor   Vendedor? @relation(fields: [vendedorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jornadas    FuncionarioJornada[]
  registros   PontoRegistro[]
  documentos  FuncionarioDocumento[]
  exames      FuncionarioExame[]
  atestados   FuncionarioAtestado[]
  avaliacoes  FuncionarioAvaliacao[]
  ocorrencias PontoOcorrencia[]
  folhas      FolhaPeriodo[]
  acertos     PontoAcerto[]

  @@index([ativo])
  @@map("funcionarios")
}

// Pedido de acerto de ponto feito pelo PRÓPRIO funcionário na tela do link
// ("esqueci de bater"). Um pedido leva vários horários (itens) e o RH aprova
// tudo de uma vez ou item a item.
model PontoAcerto {
  id            String    @id @default(uuid())
  funcionarioId String    @map("funcionario_id")
  motivo        String?
  status        String    @default("PENDENTE") // PENDENTE | RESPONDIDO
  respondidoPor String?   @map("respondido_por") // id do usuário do app
  respondidoNome String?  @map("respondido_nome") // nome, para mostrar ao funcionário
  respondidoEm  DateTime? @map("respondido_em")
  lidoEm        DateTime? @map("lido_em") // quando o funcionário deu "OK, entendi"
  createdAt     DateTime  @default(now()) @map("created_at")

  funcionario Funcionario       @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  itens       PontoAcertoItem[]

  @@index([funcionarioId, status])
  @@index([status])
  @@map("ponto_acertos")
}

// Cada horário esquecido dentro de um pedido
model PontoAcertoItem {
  id           String  @id @default(uuid())
  acertoId     String  @map("acerto_id")
  data         String // YYYY-MM-DD
  hora         String // HH:MM
  tipo         String // ENTRADA | SAIDA
  status       String  @default("PENDENTE") // PENDENTE | APROVADO | RECUSADO
  motivoRecusa String? @map("motivo_recusa")
  batidaId     String? @map("batida_id") // batida criada quando aprovado

  acerto PontoAcerto @relation(fields: [acertoId], references: [id], onDelete: Cascade)

  @@index([acertoId])
  @@map("ponto_acerto_itens")
}

// Marcação manual de um DIA do cartão de ponto (o RH diz o que foi aquele dia).
// Sem marcação o dia é classificado sozinho pelas batidas + escala.
model PontoOcorrencia {
  id            String   @id @default(uuid())
  funcionarioId String   @map("funcionario_id")
  data          String // YYYY-MM-DD (timezone SP)
  tipo          String // FALTA | ABONO | FERIADO | FOLGA
  obs           String?
  registradoPor String?  @map("registrado_por") // id do usuário que marcou
  createdAt     DateTime @default(now()) @map("created_at")

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, data])
  @@index([data])
  @@map("ponto_ocorrencias")
}

// Ajustes manuais da folha de um período (vale, adiantamento, prêmio…)
model FolhaPeriodo {
  id              String   @id @default(uuid())
  funcionarioId   String   @map("funcionario_id")
  de              String // YYYY-MM-DD
  ate             String // YYYY-MM-DD
  outrosProventos Decimal  @default(0) @map("outros_proventos") @db.Decimal(12, 2)
  outrosDescontos Decimal  @default(0) @map("outros_descontos") @db.Decimal(12, 2)
  obs             String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, de, ate])
  @@map("folha_periodos")
}

// Escala semanal (uma linha por dia da semana)
model FuncionarioJornada {
  id            String  @id @default(uuid())
  funcionarioId String  @map("funcionario_id")
  diaSemana     Int     @map("dia_semana") // 0=Dom ... 6=Sáb
  entrada1      String? // "HH:MM"
  saida1        String?
  entrada2      String?
  saida2        String?
  folga         Boolean @default(false)

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, diaSemana])
  @@map("funcionario_jornadas")
}

// Batida de ponto
model PontoRegistro {
  id              String   @id @default(uuid())
  funcionarioId   String   @map("funcionario_id")
  dataReferencia  String   @map("data_referencia") // YYYY-MM-DD (timezone SP)
  tipo            String // ENTRADA | SAIDA
  hora            DateTime @default(now())
  latLng          String?  @map("lat_lng") // "lat,lng"
  distanciaMetros Int?     @map("distancia_metros")
  dentroCerca     Boolean? @map("dentro_cerca")
  origem          String   @default("LINK") // LINK | MANUAL | CSV
  ajustadoPor     String?  @map("ajustado_por") // id do usuário que ajustou
  obs             String?
  createdAt       DateTime @default(now()) @map("created_at")

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId])
  @@index([dataReferencia])
  @@map("ponto_registros")
}

// Documentos pessoais / pasta livre (PDF ou imagem)
model FuncionarioDocumento {
  id            String   @id @default(uuid())
  funcionarioId String   @map("funcionario_id")
  categoria     String // RG | CPF | CTPS | RESIDENCIA | CONTRATO | OUTRO
  nome          String
  arquivo       String // caminho relativo em /uploads
  createdAt     DateTime @default(now()) @map("created_at")

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId])
  @@map("funcionario_documentos")
}

// Exames ocupacionais (ASO)
model FuncionarioExame {
  id            String    @id @default(uuid())
  funcionarioId String    @map("funcionario_id")
  tipo          String // ADMISSIONAL | PERIODICO | DEMISSIONAL | RETORNO | MUDANCA_FUNCAO
  data          DateTime
  validade      DateTime?
  resultado     String? // APTO | INAPTO
  arquivo       String?
  obs           String?
  createdAt     DateTime  @default(now()) @map("created_at")

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId])
  @@map("funcionario_exames")
}

// Atestados médicos
model FuncionarioAtestado {
  id            String   @id @default(uuid())
  funcionarioId String   @map("funcionario_id")
  dataInicio    DateTime @map("data_inicio")
  dias          Int      @default(1)
  cid           String?
  arquivo       String?
  obs           String?
  createdAt     DateTime @default(now()) @map("created_at")

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId])
  @@map("funcionario_atestados")
}

// Avaliações de desempenho
model FuncionarioAvaliacao {
  id            String   @id @default(uuid())
  funcionarioId String   @map("funcionario_id")
  periodo       String // ex: "2026-06"
  nota          Decimal  @default(0) @db.Decimal(4, 2)
  criterios     Json?
  obs           String?
  avaliadorId   String?  @map("avaliador_id")
  data          DateTime @default(now())

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId])
  @@map("funcionario_avaliacoes")
}

model TabelaPreco {
  id                           String   @id // id-Pgto (Ex: "1000")
  idCondicao                   String   @map("id_condicao") // ID_CONDICAO (Ex: "AVISTA_DIN")
  nomeCondicao                 String   @map("nome_condicao") // NOME_CONDICAO
  tipoPagamento                String?  @map("tipo_pagamento") // TIPO_PAGAMENTO
  opcaoCondicao                String?  @map("opcao_condicao") // opcao_condicao_pagamento
  qtdParcelas                  Int      @default(1) @map("qtd_parcelas")
  parcelasDias                 Int      @default(0) @map("parcelas_dias")
  acrescimoPreco               Decimal  @default(0) @map("acrescimo_preco") @db.Decimal(10, 2)
  parcelasPercentuais          Decimal  @default(100) @map("parcelas_percentuais") @db.Decimal(10, 2)
  valorMinimo                  Decimal? @default(0) @map("valor_minimo") @db.Decimal(12, 2)
  exigeBanco                   Boolean  @default(false) @map("exige_banco")
  bancoPadrao                  String?  @map("banco_padrao")
  debitaCaixa                  Boolean  @default(false) @map("debita_caixa")
  ativo                        Boolean  @default(true)
  permiteEspecial              Boolean  @default(false) @map("permite_especial") // Condição disponível para pedidos especiais
  permitePedido                Boolean  @default(true) @map("permite_pedido") // Condição disponível para pedidos comuns
  permiteBonificacao           Boolean  @default(false) @map("permite_bonificacao") // Condição disponível para pedidos bonificação
  permiteCatalogoPersonalizado Boolean  @default(true) @map("permite_catalogo_personalizado") // Aparece no seletor de condição do catálogo personalizado
  exigeAprovacaoCredito        Boolean  @default(false) @map("exige_aprovacao_credito") // Condição sujeita a aprovação de crédito (ex.: boleto) — marca a lista como "mediante aprovação de crédito" quando não aprovada
  obs                          String?
  formasRecebimentoPermitidas  Json?    @map("formas_recebimento_permitidas") // IDs das formas de recebimento permitidas na entrega: ["tabela_1000", "uuid-forma"]
  permiteDevolucaoTotal        Boolean  @default(true) @map("permite_devolucao_total")
  permiteDevolucaoParcial      Boolean  @default(true) @map("permite_devolucao_parcial")
  regrasCategoria              Json?    @map("regras_categoria") // Regras de preço por categoria CA para especiais: [{ categoria, precoBase, acrescimo }]
  categoriasEspecial           Json?    @map("categorias_especial") // Categorias de produto visíveis em pedidos especiais: ["cat1", "cat2"]
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  @@map("tabela_precos")
}

model ContaFinanceira {
  id              String    @id // ID_CONTA_FINANCEIRA
  nomeBanco       String    @map("nome_banco") // NOME_BANCO
  tipoUso         String    @map("tipo_uso") // TIPO_USO
  ativo           Boolean   @default(true)
  ultimaCapturaEm DateTime? @map("ultima_captura_em") // ULTIMA_CAPTURA_EM
  fonteVendaId    String?   @map("fonte_venda_id") // FONTE_VENDA_ID
  obs             String?
  opcaoCondicao   String?   @map("opcao_condicao") // OPCAO_CONDICAO (Visual reference)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // FKs reais desde a Fase 0 Contabilidade (antes contaFinanceiraCaId era texto solto).
  // Escritas com conta vinda de fora (sync CA/Asaas/Baixa CA) passam por
  // contaFinanceiraGuardService.garantirContaFinanceira, que cria a conta inativa se faltar.
  parcelas             Parcela[]               @relation("ParcelasConta")
  pagamentosReceber    PagamentoParcela[]      @relation("PagamentosReceberConta")
  contasPagar          ContaPagar[]            @relation("ContasPagarConta")
  pagamentosPagar      PagamentoParcelaPagar[] @relation("PagamentosPagarConta")
  extratoImportacoes   ExtratoImportacao[]     @relation("ExtratoImportacoesConta")
  extratoLancamentos   ExtratoLancamento[]     @relation("ExtratoLancamentosConta")
  conciliacaoGrupos    ConciliacaoGrupo[]      @relation("ConciliacaoGruposConta")
  ajustesSaldo         AjusteSaldoConta[]      @relation("AjustesSaldoContaFin")
  transferenciasOrigem TransferenciaConta[]    @relation("TransferenciasOrigem")
  transferenciasDestino TransferenciaConta[]   @relation("TransferenciasDestino")

  @@map("contas_financeiras")
}

// Ajuste manual de saldo por conta (banco/caixa) — lançamento avulso para acertar
// o resultado de uma conta na tela Saldos por Conta. Valor positivo = entrada,
// negativo = saída. Só existe no app (não vai ao Conta Azul).
model AjusteSaldoConta {
  id                  String    @id @default(uuid())
  contaFinanceiraCaId String?   @map("conta_financeira_ca_id") // null = "Não informado"
  contaFinanceira     ContaFinanceira? @relation("AjustesSaldoContaFin", fields: [contaFinanceiraCaId], references: [id], onDelete: Restrict)
  data                DateTime
  valor               Decimal   @db.Decimal(12, 2)
  descricao           String
  criadoPorId         String?   @map("criado_por_id")
  criadoPor           Vendedor? @relation("AjustesSaldoCriados", fields: [criadoPorId], references: [id])
  criadoEm            DateTime  @default(now()) @map("criado_em")

  @@index([contaFinanceiraCaId])
  @@index([data])
  @@map("ajustes_saldo_conta")
}

// =============================================
// SISTEMA DE PROMOÇÕES
// =============================================

model Promocao {
  id               String   @id @default(uuid())
  produtoId        String   @map("produto_id")
  nome             String
  tipo             String // SIMPLES ou CONDICIONAL
  precoPromocional Decimal  @map("preco_promocional") @db.Decimal(10, 2)
  dataInicio       DateTime @map("data_inicio")
  dataFim          DateTime @map("data_fim")
  status           String   @default("ATIVA") // ATIVA ou ENCERRADA

  // Auditoria de criação
  criadoPor String   @map("criado_por") // vendedorId
  criadoEm  DateTime @default(now()) @map("criado_em")

  // Auditoria de encerramento
  encerradoPor           String?   @map("encerrado_por") // vendedorId
  encerradoEm            DateTime? @map("encerrado_em")
  encerradaAntesPrevisto Boolean?  @map("encerrada_antes_previsto")

  produto        Produto                 @relation(fields: [produtoId], references: [id])
  grupos         PromocaoCondicaoGrupo[]
  metasPromocoes MetaPromocao[]

  @@index([produtoId])
  @@index([status])
  @@map("promocoes")
}

model PromocaoCondicaoGrupo {
  id         String @id @default(uuid())
  promocaoId String @map("promocao_id")

  promocao  Promocao           @relation(fields: [promocaoId], references: [id], onDelete: Cascade)
  condicoes PromocaoCondicao[]

  @@index([promocaoId])
  @@map("promocao_condicao_grupos")
}

model PromocaoCondicao {
  id               String   @id @default(uuid())
  grupoId          String   @map("grupo_id")
  tipo             String // PRODUTO_QUANTIDADE ou VALOR_TOTAL
  produtoId        String?  @map("produto_id") // Para tipo PRODUTO_QUANTIDADE
  quantidadeMinima Decimal? @map("quantidade_minima") @db.Decimal(12, 3)
  valorMinimo      Decimal? @map("valor_minimo") @db.Decimal(12, 2)

  grupo PromocaoCondicaoGrupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@index([grupoId])
  @@map("promocao_condicoes")
}

// =============================================
// MODULO CRM: ROTA + LEADS
// =============================================

model Lead {
  id                  String    @id @default(uuid())
  numero              Int       @default(autoincrement())
  nomeEstabelecimento String    @map("nome_estabelecimento")
  contato             String?
  whatsapp            String?
  diasVisita          String?   @map("dias_visita")
  horarioAtendimento  String?   @map("horario_atendimento")
  horarioEntrega      String?   @map("horario_entrega")
  formasAtendimento   String[]  @default([]) @map("formas_atendimento")
  pontoGps            String?   @map("ponto_gps")
  etapa               String    @default("NOVO")
  proximaVisita       DateTime? @map("proxima_visita")
  observacoes         String?   @db.Text
  fotoFachada         String?   @map("foto_fachada")

  cidade             String?
  origemLead         String?           @map("origem_lead")
  categoriaClienteId String?           @map("categoria_cliente_id")
  categoriaCliente   CategoriaCliente? @relation(fields: [categoriaClienteId], references: [id])

  idVendedor String?   @map("id_vendedor")
  vendedor   Vendedor? @relation(fields: [idVendedor], references: [id])

  clienteId String?  @map("cliente_id")
  cliente   Cliente? @relation(fields: [clienteId], references: [UUID])

  atendimentos Atendimento[]
  amostras     Amostra[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([idVendedor])
  @@index([etapa])
  @@index([clienteId])
  @@map("leads")
}

model Atendimento {
  id            String    @id @default(uuid())
  tipo          String
  observacao    String?   @db.Text
  etapaAnterior String?   @map("etapa_anterior")
  etapaNova     String?   @map("etapa_nova")
  proximaVisita DateTime? @map("proxima_visita")
  gpsVendedor   String?   @map("gps_vendedor")
  pedidoId      String?   @map("pedido_id")

  // Ação estruturada
  acaoKey   String? @map("acao_key")
  acaoLabel String? @map("acao_label")

  // Transferência
  transferidoParaId         String?   @map("transferido_para_id")
  transferidoPara           Vendedor? @relation("AtendimentoTransferido", fields: [transferidoParaId], references: [id])
  transferenciaFinalizada   Boolean   @default(false) @map("transferencia_finalizada")
  transferenciaFinalizadaEm DateTime? @map("transferencia_finalizada_em")
  transferenciaVistaOrigem  Boolean   @default(false) @map("transferencia_vista_origem")

  // Retorno
  assuntoRetorno String?   @map("assunto_retorno") @db.Text
  dataRetorno    DateTime? @map("data_retorno")

  // Alerta visual
  alertaVisualAtivo Boolean @default(false) @map("alerta_visual_ativo")
  alertaVisualCor   String? @map("alerta_visual_cor")
  alertaVisualVisto Boolean @default(false) @map("alerta_visual_visto")

  // Amostra vinculada
  amostraId String?  @map("amostra_id")
  amostra   Amostra? @relation(fields: [amostraId], references: [id])

  leadId    String?  @map("lead_id")
  lead      Lead?    @relation(fields: [leadId], references: [id])
  clienteId String?  @map("cliente_id")
  cliente   Cliente? @relation(fields: [clienteId], references: [UUID])

  idVendedor String   @map("id_vendedor")
  vendedor   Vendedor @relation(fields: [idVendedor], references: [id])

  // Usuário real que registrou o atendimento (pode ser diferente do vendedor responsável pelo cliente)
  usuarioRegistroId String?   @map("usuario_registro_id")
  usuarioRegistro   Vendedor? @relation("AtendimentoRegistro", fields: [usuarioRegistroId], references: [id])

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([leadId])
  @@index([clienteId])
  @@index([idVendedor])
  @@index([transferidoParaId])
  @@index([dataRetorno])
  @@index([alertaVisualAtivo])
  @@map("atendimentos")
}

// =============================================
// MÓDULO PONTO E VEÍCULOS (DIÁRIO / GATE)
// =============================================

model Veiculo {
  id           String   @id @default(uuid())
  placa        String   @unique
  modelo       String
  documentoUrl String?  @map("documento_url")
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Seguro
  seguroVencimento DateTime? @map("seguro_vencimento")
  seguroApolice    String?   @map("seguro_apolice")
  seguroSeguradora String?   @map("seguro_seguradora")
  seguroApoliceUrl String?   @map("seguro_apolice_url")

  // Métricas e Configurações
  capacidadeTanque Decimal? @map("capacidade_tanque") @db.Decimal(8, 2)
  kmMedioSugerido  Int?     @map("km_medio_sugerido")
  tipoCombustivel  String?  @map("tipo_combustivel") // "DIESEL" | "GASOLINA"
  observacoes      String?  @db.Text

  diarios           DiarioVendedor[]
  despesas          Despesa[]
  alertasManutencao ManutencaoAlerta[]

  @@map("veiculos")
}

model DiarioVendedor {
  id             String @id @default(uuid())
  vendedorId     String @map("vendedor_id")
  modo           String // HOME_OFFICE ou PRESENCIAL
  dataReferencia String @map("data_referencia") // YYYY-MM-DD para busca exata (sem HH:MM)

  // Se Presencial
  veiculoId String? @map("veiculo_id")
  kmInicial Int?    @map("km_inicial")
  kmFinal   Int?    @map("km_final")
  checklist Json? // Array de booleans/strings
  obs       String? @db.Text

  // Timestamps de Ponto
  inicioHora DateTime  @default(now()) @map("inicio_hora")
  fimHora    DateTime? @map("fim_hora")

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])
  veiculo  Veiculo? @relation(fields: [veiculoId], references: [id])

  @@unique([vendedorId, dataReferencia])
  @@index([vendedorId])
  @@index([dataReferencia])
  @@index([veiculoId])
  @@map("diario_vendedor")
}

// =============================================
// MÓDULO EMBARQUE E ENTREGAS 
// =============================================

model Embarque {
  id        String   @id @default(uuid())
  numero    Int      @default(autoincrement())
  dataSaida DateTime @map("data_saida")

  responsavelId String   @map("responsavel_id") // Vendedor/Usuário responsável
  responsavel   Vendedor @relation(fields: [responsavelId], references: [id])

  pedidos       Pedido[]
  amostras      Amostra[]
  cobrancasRota CobrancaRota[] // títulos pendurados na carga para cobrar na rota

  // Versionamento da carga: sobe a cada alteração (data, motorista, pedidos, amostras).
  // A folha impressa carimba a versão + QR; o motorista confere pelo app se a folha ainda vale.
  versao                Int                 @default(1)
  ultimaImpressaoVersao Int?                @map("ultima_impressao_versao")
  ultimaImpressaoEm     DateTime?           @map("ultima_impressao_em")
  versoes               EmbarqueVersaoLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("embarques")
}

// Histórico de versões do embarque (molde: ReceitaVersaoLog).
// Registro é best-effort: falha aqui NUNCA derruba a operação principal.
model EmbarqueVersaoLog {
  id              String   @id @default(uuid())
  embarqueId      String   @map("embarque_id")
  embarque        Embarque @relation(fields: [embarqueId], references: [id], onDelete: Cascade)
  versao          Int
  acao            String // CRIADA | EDITADA | PEDIDOS_ADICIONADOS | PEDIDO_REMOVIDO | AMOSTRAS_ADICIONADAS | AMOSTRA_REMOVIDA | IMPRESSA
  alteracoes      Json?
  alteradoPorId   String?  @map("alterado_por_id")
  alteradoPorNome String?  @map("alterado_por_nome")
  criadoEm        DateTime @default(now()) @map("criado_em")

  @@index([embarqueId])
  @@map("embarque_versao_log")
}

model ClienteInsight {
  clienteId                   String    @id @map("cliente_id")
  dataUltimoPedido            DateTime? @map("data_ultimo_pedido")
  diasSemComprar              Int?      @map("dias_sem_comprar")
  cicloReferenciaDias         Int       @map("ciclo_referencia_dias")
  origemCiclo                 String    @map("origem_ciclo") // PERSONALIZADO, CATEGORIA, PADRAO
  statusRecompra              String    @map("status_recompra") // SEM_HISTORICO, NO_PRAZO, ATENCAO, ATRASADO, CRITICO
  qtdPedidosUltimos30d        Int       @default(0) @map("qtd_pedidos_ultimos_30d")
  ticketMedioBase             Decimal?  @map("ticket_medio_base") @db.Decimal(12, 2)
  ticketMedioRecente          Decimal?  @map("ticket_medio_recente") @db.Decimal(12, 2)
  variacaoTicketPct           Decimal?  @map("variacao_ticket_pct") @db.Decimal(8, 2)
  itensMediosBase             Decimal?  @map("itens_medios_base") @db.Decimal(10, 2)
  itensMediosRecentes         Decimal?  @map("itens_medios_recentes") @db.Decimal(10, 2)
  variacaoItensPct            Decimal?  @map("variacao_itens_pct") @db.Decimal(8, 2)
  produtoAusenteId            String?   @map("produto_ausente_id")
  produtoAusenteFrequencia    Int       @default(0) @map("produto_ausente_frequencia")
  produtoAusenteDesdePedidos  Int       @default(0) @map("produto_ausente_desde_pedidos")
  categoriaEmQuedaId          String?   @map("categoria_em_queda_id")
  categoriaQuedaPct           Decimal?  @map("categoria_queda_pct") @db.Decimal(8, 2)
  teveDevolucaoRecente        Boolean   @default(false) @map("teve_devolucao_recente")
  dataUltimaDevolucao         DateTime? @map("data_ultima_devolucao")
  motivoUltimaDevolucao       String?   @map("motivo_ultima_devolucao") @db.Text
  qtdAtendimentosSemPedido30d Int       @default(0) @map("qtd_atendimentos_sem_pedido_30d")
  dataUltimoAtendimento       DateTime? @map("data_ultimo_atendimento")
  canalUltimoAtendimento      String?   @map("canal_ultimo_atendimento")
  scoreRisco                  Int       @default(0) @map("score_risco")
  scoreOportunidade           Int       @default(0) @map("score_oportunidade")
  insightPrincipalTipo        String?   @map("insight_principal_tipo")
  insightPrincipalResumo      String?   @map("insight_principal_resumo") @db.Text
  proximaAcaoSugerida         String?   @map("proxima_acao_sugerida") @db.Text
  orientacaoIaJson            Json?     @map("orientacao_ia_json") // Análise gerada por IA (GPT-4o-mini)
  recalculadoEm               DateTime  @map("recalculado_em")

  cliente Cliente @relation(fields: [clienteId], references: [UUID], onDelete: Cascade)

  @@index([recalculadoEm(sort: Desc)])
  @@index([statusRecompra])
  @@index([scoreRisco])
  @@map("cliente_insights")
}

model FormaPagamentoEntrega {
  id                           String   @id @default(uuid())
  nome                         String
  permiteVendedorResponsavel   Boolean  @default(false) @map("permite_vendedor_responsavel")
  permiteEscritorioResponsavel Boolean  @default(false) @map("permite_escritorio_responsavel")
  ativo                        Boolean  @default(true)
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  pagamentosReais PedidoPagamentoReal[]

  @@map("formas_pagamento_entrega")
}

model PedidoPagamentoReal {
  id                      String  @id @default(uuid())
  pedidoId                String  @map("pedido_id")
  formaPagamentoEntregaId String? @map("forma_pagamento_entrega_id")

  formaPagamentoNome String  @map("forma_pagamento_nome") // Nome na hora, para histórico
  valor              Decimal @db.Decimal(12, 2)

  // ── Responsabilidade pela cobrança (Dívida/Ação) ────────────────────────────────────
  // PAPEL de quem ficou de cobrar: VENDEDOR | ESCRITORIO | MOTORISTA.
  // A PESSOA continua sendo `vendedorResponsavelId` — é UMA coluna só de pessoa, de
  // propósito: uma segunda coluna obrigaria todo ponto do sistema a virar "um ou outro"
  // (groupBy em duas consultas, `some` com OR, índice duplicado) e seis lugares novos
  // para alguém esquecer o campo.
  // ⚠️ Vazio = marcação LEGADA (as 44 gravadas antes de 08/2026). O papel é DERIVADO por
  // `recebimentoEntregaService.papelResponsavel()` — nunca leia estes campos crus.
  responsavelPapel String? @map("responsavel_papel")

  // legado — a marcação antiga, anterior ao `responsavelPapel`. NÃO REMOVER: o deploy usa
  // `prisma db push` sem `--accept-data-loss` e dropar coluna derruba o servidor.
  // `vendedorResponsavelId` segue em uso como a PESSOA de VENDEDOR e de MOTORISTA.
  vendedorResponsavelId String? @map("vendedor_responsavel_id")
  escritorioResponsavel Boolean @default(false) @map("escritorio_responsavel")

  // PIX pago via Asaas na entrega (dinheiro confirmado pelo banco antes de finalizar).
  // Sem @unique: constraint nova trava o `prisma db push` do deploy — unicidade garantida no código (entregas.js).
  cobrancaAsaasId String? @map("cobranca_asaas_id")

  pedido              Pedido                 @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  formaPagamento      FormaPagamentoEntrega? @relation(fields: [formaPagamentoEntregaId], references: [id])
  vendedorResponsavel Vendedor?              @relation("PagamentosFiados", fields: [vendedorResponsavelId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([pedidoId])
  // Filtro/relatório "Responsável pela cobrança" busca por esta coluna (rota
  // /contas-receber/responsaveis e o `some` do filtro). Sem índice era varredura completa
  // da tabela a cada abertura da tela. ⚠️ Índice criado só na mão é derrubado pelo
  // `prisma db push` do deploy — por isso fica declarado aqui.
  @@index([vendedorResponsavelId])
  @@map("pedido_pagamentos_reais")
}

model EntregaItemDevolvido {
  id            String  @id @default(uuid())
  pedidoId      String  @map("pedido_id")
  produtoId     String  @map("produto_id")
  quantidade    Decimal @db.Decimal(12, 3)
  valorBaseItem Decimal @map("valor_base_item") @db.Decimal(12, 2) // Valor do item devolvido para registro e cálculo de estorno

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([pedidoId])
  @@map("entrega_itens_devolvidos")
}

// =============================================
// MÓDULO CAIXA DIÁRIO E DESPESAS
// =============================================

model Despesa {
  id             String @id @default(uuid())
  vendedorId     String @map("vendedor_id")
  dataReferencia String @map("data_referencia") // YYYY-MM-DD

  categoria String // MERCADORIA_EMPRESA | COMBUSTIVEL | PEDAGIO_BALSA | HOTEL_HOSPEDAGEM | MANUTENCAO_VEICULO | OUTRO
  descricao String? @db.Text
  valor     Decimal @db.Decimal(12, 2)

  // Combustivel-specific
  veiculoId         String?  @map("veiculo_id")
  litros            Decimal? @db.Decimal(10, 3)
  kmNoAbastecimento Int?     @map("km_no_abastecimento")

  // Manutencao-specific
  tipoManutencao String? @map("tipo_manutencao") // LAMPADA | PNEU | OLEO | FILTRO | OUTRO

  criadoPor String   @map("criado_por")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vendedor Vendedor @relation("DespesasDoVendedor", fields: [vendedorId], references: [id])
  veiculo  Veiculo? @relation(fields: [veiculoId], references: [id])

  @@index([vendedorId])
  @@index([dataReferencia])
  @@index([categoria])
  @@map("despesas")
}

model CaixaDiario {
  id             String @id @default(uuid())
  vendedorId     String @map("vendedor_id")
  dataReferencia String @map("data_referencia") // YYYY-MM-DD

  adiantamento        Decimal   @default(0) @db.Decimal(12, 2)
  // Quem lançou o adiantamento (mudar/zerar exige ser o autor, admin ou permissão própria)
  adiantamentoPorId   String?   @map("adiantamento_por_id")
  adiantamentoPorNome String?   @map("adiantamento_por_nome")
  adiantamentoEm      DateTime? @map("adiantamento_em")
  status              String    @default("ABERTO") // ABERTO | FECHADO | CONFERIDO

  // Snapshots ao fechar
  totalDespesas       Decimal? @map("total_despesas") @db.Decimal(12, 2)
  totalRecebidoCaixa  Decimal? @map("total_recebido_caixa") @db.Decimal(12, 2)
  totalRecebidoOutros Decimal? @map("total_recebido_outros") @db.Decimal(12, 2)
  valorAPrestar       Decimal? @map("valor_a_prestar") @db.Decimal(12, 2)

  conferidoPor String?   @map("conferido_por")
  conferidoEm  DateTime? @map("conferido_em")
  obsAdmin     String?   @map("obs_admin") @db.Text

  // ── Conferência do DINHEIRO (passo obrigatório ANTES de fechar) ──
  // ABERTO → (folha impressa ou virada do dia) → A CONFERIR → dinheiro conferido
  // → A FECHAR → FECHADO. A trava só vale com a chave ligada: `caixaConferenciaConfig.js`.

  // Envio para conferência — a folha impressa é a prestação de contas
  enviadoConferenciaEm      DateTime? @map("enviado_conferencia_em")
  enviadoConferenciaPorId   String?   @map("enviado_conferencia_por_id")
  enviadoConferenciaPorNome String?   @map("enviado_conferencia_por_nome")
  enviadoConferenciaOrigem  String?   @map("enviado_conferencia_origem") // IMPRESSAO | VIRADA_DIA | MANUAL

  // Assinatura de quem contou o dinheiro
  dinheiroConferido        Boolean   @default(false) @map("dinheiro_conferido")
  dinheiroConferidoPorId   String?   @map("dinheiro_conferido_por_id")
  dinheiroConferidoPorNome String?   @map("dinheiro_conferido_por_nome")
  dinheiroConferidoEm      DateTime? @map("dinheiro_conferido_em")
  // Snapshot do valor a prestar no instante da conferência — se o valor mudar
  // depois, a conferência cai sozinha e o caixa volta para a fila de quem confere.
  valorEsperadoConferencia Decimal?  @map("valor_esperado_conferencia") @db.Decimal(12, 2)
  valorContado             Decimal?  @map("valor_contado") @db.Decimal(12, 2)
  // Contagem física: { cedulas: {"200":2,…}, moedas: {"1":3,…}, outros: [{descricao, valor}] }
  contagemDinheiro         Json?     @map("contagem_dinheiro")
  obsConferenciaDinheiro   String?   @map("obs_conferencia_dinheiro") @db.Text

  // Diferença (quebra de caixa): dentro do limite do conferente ele fecha sozinho;
  // acima, exige senha de quem tem Pode_Autorizar_Diferenca_Caixa.
  diferencaConferencia     Decimal? @map("diferenca_conferencia") @db.Decimal(12, 2)
  motivoDiferenca          String?  @map("motivo_diferenca") @db.Text
  autorizadorDiferencaId   String?  @map("autorizador_diferenca_id")
  autorizadorDiferencaNome String?  @map("autorizador_diferenca_nome")
  quebraAplicada           Decimal? @map("quebra_aplicada") @db.Decimal(12, 2) // limite do conferente no momento

  // Fechamento (quem fechou — nunca quem conferiu)
  fechadoPorId   String?   @map("fechado_por_id")
  fechadoPorNome String?   @map("fechado_por_nome")
  fechadoEm      DateTime? @map("fechado_em")
  reabertoMotivo String?   @map("reaberto_motivo") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vendedor             Vendedor                   @relation(fields: [vendedorId], references: [id])
  entregasConferidas   CaixaEntregaConferida[]
  conferenciaDevolucao CaixaConferenciaDevolucao?
  // Baixas de títulos em espécie lançadas neste caixa (somam no valor a prestar)
  recebimentosTitulos PagamentoParcela[] @relation("RecebimentosTitulos")
  // Canhotos de NF bipados durante este caixa (só auditoria — a lista do dia é por consulta)
  canhotosBipados     CanhotoNota[]

  @@unique([vendedorId, dataReferencia])
  @@index([vendedorId])
  @@index([dataReferencia])
  @@index([status])
  @@map("caixa_diario")
}

model CaixaEntregaConferida {
  id            String @id @default(uuid())
  caixaDiarioId String @map("caixa_diario_id")
  pedidoId      String @map("pedido_id")

  conferido    Boolean   @default(false)
  conferidoPor String?   @map("conferido_por")
  conferidoEm  DateTime? @map("conferido_em")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  caixaDiario CaixaDiario @relation(fields: [caixaDiarioId], references: [id], onDelete: Cascade)
  pedido      Pedido      @relation(fields: [pedidoId], references: [id])

  @@unique([caixaDiarioId, pedidoId])
  @@map("caixa_entrega_conferida")
}

// Conferência física da mercadoria devolvida pelo motorista (1 por caixa/dia).
// O que o motorista marcou como devolvido nas entregas tem que voltar fisicamente;
// falta sem autorização vira cobrança (valor somado ao valor a prestar do caixa).
model CaixaConferenciaDevolucao {
  id            String @id @default(uuid())
  caixaDiarioId String @unique @map("caixa_diario_id")

  status             String    @default("PENDENTE") // PENDENTE | CONFERIDA
  conferidoPorId     String?   @map("conferido_por_id")
  conferidoPorNome   String?   @map("conferido_por_nome")
  conferidoEm        DateTime? @map("conferido_em")
  totalCobrado       Decimal   @default(0) @map("total_cobrado") @db.Decimal(12, 2)
  // Snapshot da tabela de preço usada na cobrança (não muda se a config do vendedor mudar depois)
  tabelaCobrancaId   String?   @map("tabela_cobranca_id")
  tabelaCobrancaNome String?   @map("tabela_cobranca_nome")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  caixaDiario CaixaDiario                     @relation(fields: [caixaDiarioId], references: [id], onDelete: Cascade)
  itens       CaixaConferenciaDevolucaoItem[]

  @@map("caixa_conferencia_devolucao")
}

model CaixaConferenciaDevolucaoItem {
  id            String @id @default(uuid())
  conferenciaId String @map("conferencia_id")
  produtoId     String @map("produto_id")
  produtoNome   String @map("produto_nome") // snapshot

  qtdEsperada       Decimal @default(0) @map("qtd_esperada") @db.Decimal(12, 3) // devoluções registradas nas entregas
  qtdRecebida       Decimal @default(0) @map("qtd_recebida") @db.Decimal(12, 3) // contagem física de quem conferiu
  qtdDesconsiderada Decimal @default(0) @map("qtd_desconsiderada") @db.Decimal(12, 3) // autorizada com senha
  qtdCobrada        Decimal @default(0) @map("qtd_cobrada") @db.Decimal(12, 3) // falta cobrada do motorista
  sobra             Boolean @default(false) // voltou sem devolução registrada (só registro)

  valorUnitCobranca Decimal? @map("valor_unit_cobranca") @db.Decimal(12, 2) // preço na tabela do motorista (snapshot)
  valorCobrado      Decimal  @default(0) @map("valor_cobrado") @db.Decimal(12, 2)

  // Autorização para desconsiderar (senha de quem tem a permissão)
  motivoDesconsiderar String?   @map("motivo_desconsiderar")
  autorizadoPorId     String?   @map("autorizado_por_id")
  autorizadoPorNome   String?   @map("autorizado_por_nome")
  autorizadoEm        DateTime? @map("autorizado_em")

  pedidosOrigem Json? @map("pedidos_origem") // [{ pedidoId, numero, cliente, quantidade }]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conferencia CaixaConferenciaDevolucao @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)

  @@unique([conferenciaId, produtoId])
  @@map("caixa_conferencia_devolucao_itens")
}

// Pedido de autorização à distância para desconsiderar falta de devolução.
// Quem confere o caixa envia; o responsável recebe um pop-up no próprio app e
// autoriza (com a senha dele) ou rejeita. Sem FK para Vendedor de propósito —
// guarda só os ids/nomes (snapshot), como outros pontos do schema.
model AutorizacaoDevolucao {
  id             String   @id @default(uuid())
  vendedorId     String   @map("vendedor_id") // dono do caixa (motorista)
  dataReferencia String   @map("data_referencia") // YYYY-MM-DD
  produtoId      String   @map("produto_id")
  produtoNome    String   @map("produto_nome") // snapshot
  quantidade     Decimal  @db.Decimal(12, 3)
  motivo         String?
  valorUnit      Decimal? @map("valor_unit") @db.Decimal(12, 2) // preço na tabela do motorista (p/ mostrar no pop-up)

  solicitanteId   String @map("solicitante_id")
  solicitanteNome String @map("solicitante_nome")
  autorizadorId   String @map("autorizador_id")
  autorizadorNome String @map("autorizador_nome")

  status         String    @default("PENDENTE") // PENDENTE | AUTORIZADA | REJEITADA | CANCELADA
  motivoRejeicao String?   @map("motivo_rejeicao")
  respondidoEm   DateTime? @map("respondido_em")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([autorizadorId, status])
  @@index([vendedorId, dataReferencia, status])
  @@map("autorizacoes_devolucao")
}

// =============================================
// LOG DE AUDITORIA (AÇÕES ADMINISTRATIVAS)
// =============================================

model AuditLog {
  id          String   @id @default(uuid())
  acao        String // REVERTER_CONFERENCIA | REABRIR_CAIXA
  entidade    String // "CaixaDiario"
  entidadeId  String   @map("entidade_id")
  detalhes    String?  @db.Text
  usuarioId   String   @map("usuario_id")
  usuarioNome String   @map("usuario_nome")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entidade, entidadeId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================
// MÓDULO MANUTENÇÃO DE VEÍCULOS
// =============================================

model ManutencaoAlerta {
  id        String @id @default(uuid())
  veiculoId String @map("veiculo_id")

  tipo      String // REVISAO | RODIZIO_PNEUS | TROCA_OLEO | TROCA_FILTRO | OUTRO
  descricao String? @db.Text

  kmAlerta   Int?      @map("km_alerta")
  dataAlerta DateTime? @map("data_alerta")

  concluido    Boolean   @default(false)
  concluidoEm  DateTime? @map("concluido_em")
  concluidoPor String?   @map("concluido_por")

  criadoPor String   @map("criado_por")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  veiculo Veiculo @relation(fields: [veiculoId], references: [id])

  @@index([veiculoId])
  @@index([concluido])
  @@map("manutencao_alertas")
}

// =============================================
// MÓDULO ROTEIRIZAÇÃO (SALVA POR USUÁRIO)
// =============================================

model Roteirizacao {
  id         String @id @default(uuid())
  vendedorId String @unique @map("vendedor_id")

  dadosConfig Json // configs used { horaSaida, tempoParadaMin, etc }
  sequencia   Json // the actual route array
  semGPS      Json // orders without GPS
  resumo      Json // distance/duration summary

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vendedor Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  @@map("roteirizacoes")
}

// =============================================
// MÓDULO METAS E PROJEÇÕES DE VENDAS
// =============================================

model MetaMensalVendedor {
  id            String @id @default(uuid())
  vendedorId    String @map("vendedor_id")
  mesReferencia String @map("mes_referencia") // Formato "YYYY-MM" (ex: "2026-03")

  diasTrabalho Json    @map("dias_trabalho") // Array de strings "YYYY-MM-DD" representando dias úteis atuantes
  valorMensal  Decimal @map("valor_mensal") @db.Decimal(12, 2)
  flexMensal   Decimal @default(0) @map("flex_mensal") @db.Decimal(12, 2)

  criadoPor String   @map("criado_por")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vendedor       Vendedor       @relation(fields: [vendedorId], references: [id])
  metasProdutos  MetaProduto[]
  metasPromocoes MetaPromocao[]
  metasCidades   MetaCidade[]

  @@unique([vendedorId, mesReferencia])
  @@index([vendedorId])
  @@index([mesReferencia])
  @@map("meta_mensal_vendedor")
}

model MetaProduto {
  id                   String  @id @default(uuid())
  metaMensalVendedorId String  @map("meta_mensal_vendedor_id")
  produtoId            String  @map("produto_id")
  quantidade           Decimal @db.Decimal(12, 3)

  metaMensalVendedor MetaMensalVendedor @relation(fields: [metaMensalVendedorId], references: [id], onDelete: Cascade)
  produto            Produto            @relation(fields: [produtoId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([metaMensalVendedorId, produtoId])
  @@map("meta_produtos")
}

model MetaPromocao {
  id                   String @id @default(uuid())
  metaMensalVendedorId String @map("meta_mensal_vendedor_id")
  promocaoId           String @map("promocao_id")
  quantidadePedidos    Int    @map("quantidade_pedidos") // Quantos pedidos com a promoção devem ser feitos

  metaMensalVendedor MetaMensalVendedor @relation(fields: [metaMensalVendedorId], references: [id], onDelete: Cascade)
  promocao           Promocao           @relation(fields: [promocaoId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([metaMensalVendedorId, promocaoId])
  @@map("meta_promocoes")
}

model MetaCidade {
  id                   String  @id @default(uuid())
  metaMensalVendedorId String  @map("meta_mensal_vendedor_id")
  cidade               String
  valor                Decimal @db.Decimal(12, 2)
  diasSemana           String? @map("dias_semana") // Ex: "SEG,QUI" — dias de entrega configurados pelo admin

  metaMensalVendedor MetaMensalVendedor @relation(fields: [metaMensalVendedorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([metaMensalVendedorId, cidade])
  @@index([metaMensalVendedorId])
  @@map("meta_cidades")
}

// =============================================
// MÓDULO AMOSTRAS (MINI-PEDIDO SEM PREÇO)
// =============================================

model Amostra {
  id              String        @id @default(uuid())
  numero          Int           @default(autoincrement())
  leadId          String?       @map("lead_id")
  lead            Lead?         @relation(fields: [leadId], references: [id])
  clienteId       String?       @map("cliente_id")
  cliente         Cliente?      @relation(fields: [clienteId], references: [UUID])
  dataEntrega     DateTime?     @map("data_entrega")
  observacao      String?       @db.Text
  status          String        @default("SOLICITADA") // SOLICITADA | PREPARACAO | LIBERADO | ENTREGUE | CANCELADA
  solicitadoPorId String        @map("solicitado_por_id")
  solicitadoPor   Vendedor      @relation("AmostrasSolicitadas", fields: [solicitadoPorId], references: [id])
  embarqueId      String?       @map("embarque_id")
  embarque        Embarque?     @relation(fields: [embarqueId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  itens           AmostraItem[]
  atendimentos    Atendimento[]

  @@index([status])
  @@index([leadId])
  @@index([embarqueId])
  @@map("amostras")
}

model AmostraItem {
  id          String  @id @default(uuid())
  amostraId   String  @map("amostra_id")
  amostra     Amostra @relation(fields: [amostraId], references: [id], onDelete: Cascade)
  produtoId   String  @map("produto_id")
  produto     Produto @relation(fields: [produtoId], references: [id])
  quantidade  Decimal @db.Decimal(12, 3)
  nomeProduto String  @map("nome_produto") // "Amostra - {nome original}"

  @@map("amostra_itens")
}

// =============================================
// MÓDULO INTELIGÊNCIA COMERCIAL (BASE CADASTRAL)
// =============================================

model CategoriaProduto {
  id              String   @id @default(uuid())
  nome            String   @unique
  descricao       String?  @db.Text
  ordemExibicao   Int      @default(0) @map("ordem_exibicao")
  corTag          String?  @map("cor_tag")
  permiteFracao   Boolean  @default(false) @map("permite_fracao")
  controlaEstoque Boolean  @default(false) @map("controla_estoque")
  ativo           Boolean  @default(true)
  tipoFlex        String   @default("NORMAL") @map("tipo_flex") // legado — mantido para não dropar a coluna
  flexPositivo    Boolean  @default(true) @map("flex_positivo") // acréscimos somam no saldo?
  flexNegativo    Boolean  @default(true) @map("flex_negativo") // descontos descontam do saldo?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  produtos Produto[]

  @@map("categorias_produto")
}

// Categorias de produto vindas do Conta Azul (ex: Produto Acabado, Materia Prima)
// Controla quais categorias participam do controle de estoque local
model CategoriaEstoque {
  id              String   @id @default(uuid())
  nome            String   @unique
  controlaEstoque Boolean  @default(false) @map("controla_estoque")
  // Se false, produtos desta categoria CA são excluídos do cálculo de flex
  contabilizaFlex Boolean  @default(true) @map("contabiliza_flex")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("categorias_estoque")
}

// ── Delivery (Kit Festa) ──
// Módulo isolado: pedidos que tenham item em categoria marcada aparecem no Kanban.

model DeliveryCategoria {
  id                      String   @id @default(uuid())
  nome                    String   @unique
  ativo                   Boolean  @default(true)
  // IDs de CategoriaProduto (sub-filtro). Vazio/null = aceita todos os produtos da categoria CA.
  categoriasComerciaisIds Json?    @map("categorias_comerciais_ids")
  createdAt               DateTime @default(now()) @map("created_at")

  @@map("delivery_categorias")
}

model DeliveryStatus {
  id                String   @id @default(uuid())
  pedidoId          String   @unique @map("pedido_id")
  etapa             String   @default("PEDIDO") // PEDIDO | PRODUCAO | SAINDO | ENTREGUE
  etapaAt           DateTime @default(now()) @map("etapa_at")
  // Quando true, movimentações não disparam WhatsApp para o cliente (bot interno continua).
  silenciarWhatsapp Boolean  @default(false) @map("silenciar_whatsapp")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([etapa])
  @@map("delivery_status")
}

model DeliveryPermissao {
  id               String   @id @default(uuid())
  vendedorId       String   @unique @map("vendedor_id")
  podeVer          Boolean  @default(false) @map("pode_ver")
  etapasPermitidas String[] @default([]) @map("etapas_permitidas")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("delivery_permissoes")
}

model DeliveryWebhookLog {
  id        String   @id @default(uuid())
  pedidoId  String   @map("pedido_id")
  etapa     String
  destino   String // BOT | WHATSAPP
  status    String // OK | ERRO
  mensagem  String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([pedidoId])
  @@map("delivery_webhook_logs")
}

/// Auditoria + fila de reenvio de TODO WhatsApp que o sistema manda pelo bot da Ana.
/// PENDENTE = falhou de forma reagendável (teto de 200/h, modo de emergência do bot,
/// Z-API fora do ar) e o worker vai tentar de novo com a MESMA `referencia` —
/// é a idempotência do bot que garante que o retry não duplique a mensagem.
model BotWhatsappEnvio {
  id         String    @id @default(uuid())
  telefone   String
  texto      String    @db.Text
  tipo       String // verificacao | pedido | entrega | cobranca | interno | outro
  origem     String?
  referencia String?
  status     String    @default("PENDENTE") // PENDENTE | ENVIADO | DUPLICADO | ERRO
  tentativas Int       @default(0)
  proximaEm  DateTime? @map("proxima_em")
  codigoErro String?   @map("codigo_erro")
  ultimoErro String?   @map("ultimo_erro") @db.Text
  enviadoEm  DateTime? @map("enviado_em")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([status, proximaEm])
  @@index([tipo, createdAt])
  @@index([referencia])
  @@map("bot_whatsapp_envios")
}

model CategoriaCliente {
  id                String   @id @default(uuid())
  nome              String   @unique
  descricao         String?  @db.Text
  cicloPadraoDias   Int      @default(7) @map("ciclo_padrao_dias")
  isentoFlex        Boolean  @default(false) @map("isento_flex")
  semLimiteDesconto Boolean  @default(false) @map("sem_limite_desconto")
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  clientes Cliente[]
  leads    Lead[]

  @@map("categorias_cliente")
}

// ── Contas a Receber ──

model ContaReceber {
  id         String  @id @default(uuid())
  pedidoId   String? @unique @map("pedido_id")
  pedido     Pedido? @relation(fields: [pedidoId], references: [id])
  clienteId  String  @map("cliente_id")
  cliente    Cliente @relation(fields: [clienteId], references: [UUID])
  origem     String  @default("ESPECIAL") // ESPECIAL | FATURADO_CA
  valorTotal Decimal @map("valor_total") @db.Decimal(12, 2)
  status     String  @default("ABERTO") // ABERTO | PARCIAL | QUITADO | CANCELADO
  observacao String? @db.Text

  parcelas Parcela[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clienteId])
  @@index([status])
  @@map("contas_receber")
}

model Parcela {
  id             String       @id @default(uuid())
  contaReceberId String       @map("conta_receber_id")
  contaReceber   ContaReceber @relation(fields: [contaReceberId], references: [id], onDelete: Cascade)
  numeroParcela  Int          @map("numero_parcela")
  valor          Decimal      @db.Decimal(12, 2)
  dataVencimento DateTime     @map("data_vencimento")

  // Baixa
  dataPagamento       DateTime? @map("data_pagamento")
  valorPago           Decimal?  @map("valor_pago") @db.Decimal(12, 2)
  valorDescontoTotal  Decimal   @default(0) @map("valor_desconto_total") @db.Decimal(12, 2)
  formaPagamento      String?   @map("forma_pagamento")
  contaFinanceiraCaId String?   @map("conta_financeira_ca_id") // UUID do banco/caixa no CA em que o dinheiro ENTROU (vem da baixa sincronizada do CA)
  // FK real desde a Fase 0 Contabilidade — escrita com conta externa passa antes por garantirContaFinanceira
  contaFinanceira     ContaFinanceira? @relation("ParcelasConta", fields: [contaFinanceiraCaId], references: [id], onDelete: Restrict)
  baixadoPorId        String?   @map("baixado_por_id")
  baixadoPor          Vendedor? @relation("BaixasRealizadas", fields: [baixadoPorId], references: [id])
  status              String    @default("PENDENTE") // PENDENTE | PARCIAL | PAGO | VENCIDO | CANCELADO
  observacao          String?   @db.Text

  pagamentos     PagamentoParcela[]
  cobrancasAsaas CobrancaAsaas[] // PIX/boleto emitidos pelo app via Asaas
  cobrancasRota  CobrancaRota[] // Cobrança em Rota (motorista/vendedor cobra na rua)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([contaReceberId])
  @@index([dataVencimento])
  @@index([status])
  @@index([contaFinanceiraCaId])
  @@map("parcelas")
}

// Histórico (ledger) de cada pagamento/desconto recebido numa parcela —
// permite baixa parcial (várias linhas até quitar) e estorno individual de cada linha.
model PagamentoParcela {
  id                  String   @id @default(uuid())
  parcelaId           String   @map("parcela_id")
  parcela             Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  valorRecebido       Decimal  @default(0) @map("valor_recebido") @db.Decimal(12, 2)
  valorDesconto       Decimal  @default(0) @map("valor_desconto") @db.Decimal(12, 2)
  motivoDesconto      String?  @map("motivo_desconto")
  formaPagamento      String?  @map("forma_pagamento")
  contaFinanceiraCaId String?  @map("conta_financeira_ca_id") // UUID do banco/caixa no CA em que o dinheiro entrou
  contaFinanceira     ContaFinanceira? @relation("PagamentosReceberConta", fields: [contaFinanceiraCaId], references: [id], onDelete: Restrict)
  dataPagamento       DateTime @map("data_pagamento")
  observacao          String?  @db.Text

  registradoPorId String   @map("registrado_por_id")
  registradoPor   Vendedor @relation("PagamentosParcelaRegistrados", fields: [registradoPorId], references: [id])

  // Por qual CAMINHO a baixa entrou. Só CONCILIACAO/CAIXA_*/ASAAS têm lastro (dinheiro
  // conferido no extrato ou prestado no caixa); MANUAL é digitada na tela de Contas a
  // Receber e por isso exige permissão própria e cai no caixa de quem baixou.
  // MANUAL | CAIXA_ROTA | CAIXA_BAIXA_CA | CONCILIACAO | ASAAS | SYNC_CA | DEVOLUCAO
  origem String? @map("origem")

  // Caixa do dia em que este dinheiro foi lançado (baixa manual em espécie). Enquanto
  // preenchido, o valor entra no "a prestar" desse caixa — é o que obriga quem baixou
  // a entregar o dinheiro. Null = não passou por caixa (conciliação, Asaas, sync…).
  caixaDiarioId String?      @map("caixa_diario_id")
  caixaDiario   CaixaDiario? @relation("RecebimentosTitulos", fields: [caixaDiarioId], references: [id])

  estornado      Boolean   @default(false)
  estornadoEm    DateTime? @map("estornado_em")
  estornadoPorId String?   @map("estornado_por_id")
  estornadoPor   Vendedor? @relation("PagamentosParcelaEstornados", fields: [estornadoPorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([parcelaId])
  @@index([dataPagamento])
  @@index([caixaDiarioId])
  @@index([contaFinanceiraCaId])
  @@map("pagamentos_parcela")
}

// Cobrança em Rota: título (parcela) que o escritório pendura na carga (ou o próprio
// motorista/vendedor localiza pela busca) para cobrar na rua. O registro em campo NUNCA
// baixa a parcela — a baixa oficial sai pelo box do Caixa (POST /caixa/cobrancas-rota/baixar),
// no mesmo ritual da Baixa CA das entregas. "Não consegui cobrar" é só registro: o título
// continua em aberto, sem efeito no caixa de ninguém.
model CobrancaRota {
  id        String  @id @default(uuid())
  parcelaId String  @map("parcela_id")
  parcela   Parcela @relation(fields: [parcelaId], references: [id])

  // Vínculo com a carga (opcional). O cobrador efetivo da carga é embarque.responsavelId —
  // trocar o motorista da carga leva as cobranças pendentes junto. Cobrança avulsa
  // (busca livre na rua) não tem embarque: nasce direto COBRADA por quem buscou.
  embarqueId      String?   @map("embarque_id")
  embarque        Embarque? @relation(fields: [embarqueId], references: [id])
  destinadoParaId String?   @map("destinado_para_id")
  destinadoPara   Vendedor? @relation("CobrancasRotaDestinadas", fields: [destinadoParaId], references: [id])
  criadoPorId     String?   @map("criado_por_id")

  status String @default("PENDENTE") // PENDENTE | COBRADA | NAO_COBRADA | BAIXADA

  // Registro da cobrança em campo (quem cobrou = dono do caixa em que o valor aparece)
  cobradoPorId       String?   @map("cobrado_por_id")
  cobradoPor         Vendedor? @relation("CobrancasRotaCobradas", fields: [cobradoPorId], references: [id])
  cobradoEm          DateTime? @map("cobrado_em")
  dataReferencia     String?   @map("data_referencia") // YYYY-MM-DD — dia do caixa em que a cobrança entra
  valorCobrado       Decimal?  @map("valor_cobrado") @db.Decimal(12, 2)
  formaPagamentoNome String?   @map("forma_pagamento_nome") // Dinheiro | Pix | Cartão | ...
  observacao         String?   @db.Text

  // "Não consegui cobrar" — só registro (título segue em aberto)
  responsavelTipo       String? @map("responsavel_tipo") // VENDEDOR | ESCRITORIO
  responsavelVendedorId String? @map("responsavel_vendedor_id")

  // Baixa pelo Caixa
  baixadoPorId       String?   @map("baixado_por_id")
  baixadoEm          DateTime? @map("baixado_em")
  pagamentoParcelaId String?   @map("pagamento_parcela_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parcelaId])
  @@index([embarqueId])
  @@index([cobradoPorId, dataReferencia])
  @@index([status])
  @@map("cobrancas_rota")
}

// =============================================
// PCP - Planejamento e Controle de Produção
// =============================================

model ItemPcp {
  id        String  @id @default(uuid())
  codigo    String  @unique
  nome      String
  tipo      String // MP | SUB | PA | EMB
  unidade   String // KG | UN | L | PCT | CX
  descricao String? @db.Text
  ativo     Boolean @default(true)

  estoqueAtual     Decimal @default(0) @map("estoque_atual") @db.Decimal(12, 3)
  estoqueMinimo    Decimal @default(0) @map("estoque_minimo") @db.Decimal(12, 3)
  estoqueReservado Decimal @default(0) @map("estoque_reservado") @db.Decimal(12, 3)

  produtoId     String?  @map("produto_id")
  produto       Produto? @relation(fields: [produtoId], references: [id])
  custoUnitario Decimal? @map("custo_unitario") @db.Decimal(12, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  receitasComoResultado Receita[]
  receitaItens          ReceitaItem[]
  ordensConsumo         OrdemConsumo[]
  movimentacoesPcp      MovimentacaoPcp[]
  sugestoes             SugestaoProducao[]
  fornecedorVinculos    FornecedorProdutoVinculo[] // Fase 2: de-para produto do fornecedor (NF-e) → item PCP
  compras               CompraItem[] // Fase 6: histórico de compras (entradas por nota)
  notaEstoqueMovs       NotaEntradaEstoqueMov[] // ledger das entradas de estoque por nota recebida

  @@index([tipo])
  @@index([produtoId])
  @@map("itens_pcp")
}

model Receita {
  id                 String    @id @default(uuid())
  itemPcpId          String    @map("item_pcp_id")
  versao             Int       @default(1)
  nome               String
  rendimentoBase     Decimal   @map("rendimento_base") @db.Decimal(12, 3)
  perdaPercentual    Decimal?  @map("perda_percentual") @db.Decimal(5, 2)
  status             String    @default("ativa") // rascunho | ativa | inativa
  dataInicioVigencia DateTime  @map("data_inicio_vigencia")
  dataFimVigencia    DateTime? @map("data_fim_vigencia")
  observacoes        String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  itemPcp        ItemPcp            @relation(fields: [itemPcpId], references: [id])
  itens          ReceitaItem[]
  ordensProducao OrdemProducao[]
  logs           ReceitaVersaoLog[]

  @@unique([itemPcpId, versao])
  @@index([status])
  @@map("receitas")
}

model ReceitaVersaoLog {
  id              String   @id @default(uuid())
  receitaId       String   @map("receita_id")
  versao          Int
  motivo          String   @db.Text
  alteracoes      Json
  alteradoPorId   String?  @map("alterado_por_id")
  alteradoPorNome String?  @map("alterado_por_nome")
  alteradoEm      DateTime @default(now()) @map("alterado_em")

  receita Receita @relation(fields: [receitaId], references: [id], onDelete: Cascade)

  @@index([receitaId])
  @@map("receita_versao_log")
}

model ReceitaItem {
  id         String  @id @default(uuid())
  receitaId  String  @map("receita_id")
  itemPcpId  String  @map("item_pcp_id")
  quantidade Decimal @db.Decimal(12, 3)
  tipo       String // MP | SUB | EMB
  ordem      Int     @default(0) // ordem de exibição do ingrediente na receita (definida no app)
  ordemEtapa String? @map("ordem_etapa") // preparo, modelagem, fritura, embalagem
  observacao String? @db.Text

  receita Receita @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  itemPcp ItemPcp @relation(fields: [itemPcpId], references: [id])

  @@map("receita_itens")
}

model OrdemProducao {
  id                  String    @id @default(uuid())
  numero              Int       @unique @default(autoincrement())
  receitaId           String    @map("receita_id")
  quantidadePlanejada Decimal   @map("quantidade_planejada") @db.Decimal(12, 3)
  quantidadeProduzida Decimal   @default(0) @map("quantidade_produzida") @db.Decimal(12, 3)
  fatorEscala         Decimal   @map("fator_escala") @db.Decimal(10, 4)
  status              String    @default("PLANEJADA") // PLANEJADA | EM_PRODUCAO | FINALIZADA | CANCELADA
  receitaSnapshot     Json      @map("receita_snapshot")
  dataPlanejada       DateTime  @map("data_planejada")
  dataInicio          DateTime? @map("data_inicio")
  dataFim             DateTime? @map("data_fim")
  observacoes         String?   @db.Text
  criadoPorId         String?   @map("criado_por_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  receita      Receita          @relation(fields: [receitaId], references: [id])
  itensConsumo OrdemConsumo[]
  agendas      AgendaProducao[]

  @@index([status])
  @@index([dataPlanejada])
  @@map("ordens_producao")
}

model OrdemConsumo {
  id                 String  @id @default(uuid())
  ordemProducaoId    String  @map("ordem_producao_id")
  itemPcpId          String  @map("item_pcp_id")
  quantidadePrevista Decimal @map("quantidade_prevista") @db.Decimal(12, 3)
  quantidadeReal     Decimal @default(0) @map("quantidade_real") @db.Decimal(12, 3)
  tipo               String // MP | SUB | EMB

  createdAt DateTime @default(now()) @map("created_at")

  ordemProducao OrdemProducao @relation(fields: [ordemProducaoId], references: [id], onDelete: Cascade)
  itemPcp       ItemPcp       @relation(fields: [itemPcpId], references: [id])

  @@map("ordens_consumo")
}

model AgendaProducao {
  id              String   @id @default(uuid())
  ordemProducaoId String   @map("ordem_producao_id")
  titulo          String
  dataInicio      DateTime @map("data_inicio")
  dataFim         DateTime @map("data_fim")
  cor             String?  @default("#3B82F6")
  observacoes     String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ordemProducao OrdemProducao @relation(fields: [ordemProducaoId], references: [id], onDelete: Cascade)

  @@map("agenda_producao")
}

model MovimentacaoPcp {
  id              String  @id @default(uuid())
  itemPcpId       String  @map("item_pcp_id")
  tipo            String // ENTRADA | SAIDA
  quantidade      Decimal @db.Decimal(12, 3)
  motivo          String // PRODUCAO_ENTRADA | PRODUCAO_CONSUMO | AJUSTE_MANUAL | COMPRA
  ordemProducaoId String? @map("ordem_producao_id")
  observacao      String? @db.Text
  estoqueAntes    Decimal @map("estoque_antes") @db.Decimal(12, 3)
  estoqueDepois   Decimal @map("estoque_depois") @db.Decimal(12, 3)
  criadoPorId     String? @map("criado_por_id")

  createdAt DateTime @default(now()) @map("created_at")

  itemPcp ItemPcp @relation(fields: [itemPcpId], references: [id])

  @@index([itemPcpId])
  @@index([createdAt])
  @@map("movimentacoes_pcp")
}

model SugestaoProducao {
  id                 String  @id @default(uuid())
  itemPcpId          String  @map("item_pcp_id")
  quantidadeSugerida Decimal @map("quantidade_sugerida") @db.Decimal(12, 3)
  bateladas          Int     @default(1)
  motivo             String // ESTOQUE_MINIMO | DEMANDA_PEDIDOS
  status             String  @default("PENDENTE") // PENDENTE | ACEITA | REJEITADA
  ordemProducaoId    String? @map("ordem_producao_id")
  observacoes        String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  itemPcp ItemPcp @relation(fields: [itemPcpId], references: [id])

  @@index([status])
  @@map("sugestoes_producao")
}

// =============================================
// MÓDULO DEVOLUÇÕES
// =============================================

model Devolucao {
  id               String @id @default(uuid())
  numero           Int    @default(autoincrement())
  pedidoOriginalId String @map("pedido_original_id")
  clienteId        String @map("cliente_id")

  tipo       String // ESPECIAL | CONTA_AZUL
  escopo     String // TOTAL | PARCIAL
  motivo     String  @db.Text
  observacao String? @db.Text

  // Campos exclusivos para devolução Conta Azul
  notaDevolucaoCA String? @map("nota_devolucao_ca")
  pdfDevolucaoUrl String? @map("pdf_devolucao_url")

  // Contexto da entrega original
  motoristaId         String?   @map("motorista_id")
  dataEntregaOriginal DateTime? @map("data_entrega_original")
  caixaDataReferencia String?   @map("caixa_data_referencia") // YYYY-MM-DD

  // Auditoria
  registradoPorId String   @map("registrado_por_id")
  dataDevolucao   DateTime @default(now()) @map("data_devolucao")

  // Status e reversão
  status         String    @default("ATIVA") // ATIVA | REVERTIDA
  revertidoPorId String?   @map("revertido_por_id")
  revertidoEm    DateTime? @map("revertido_em")
  motivoReversao String?   @map("motivo_reversao") @db.Text

  // Processamento Conta Azul (wizard boleto)
  processadoCA Boolean @default(false) @map("processado_ca")
  parcelaCAId  String? @map("parcela_ca_id") // UUID da parcela no CA
  pdfBoletoUrl String? @map("pdf_boleto_url") // PDF do novo boleto (parcial)
  wizardEtapa  String? @map("wizard_etapa") // Etapa atual do wizard (para retomar)

  // Financeiro
  valorTotal       Decimal @map("valor_total") @db.Decimal(12, 2)
  snapshotParcelas Json?   @map("snapshot_parcelas") // Snapshot das parcelas antes do ajuste

  // Relações
  pedidoOriginal Pedido          @relation(fields: [pedidoOriginalId], references: [id])
  cliente        Cliente         @relation(fields: [clienteId], references: [UUID])
  registradoPor  Vendedor        @relation("DevolucaoRegistrada", fields: [registradoPorId], references: [id])
  revertidoPor   Vendedor?       @relation("DevolucaoRevertida", fields: [revertidoPorId], references: [id])
  motorista      Vendedor?       @relation("DevolucaoMotorista", fields: [motoristaId], references: [id])
  itens          DevolucaoItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([pedidoOriginalId])
  @@index([clienteId])
  @@index([status])
  @@index([dataDevolucao])
  @@map("devolucoes")
}

model DevolucaoItem {
  id            String  @id @default(uuid())
  devolucaoId   String  @map("devolucao_id")
  produtoId     String  @map("produto_id")
  quantidade    Decimal @db.Decimal(12, 3)
  valorUnitario Decimal @map("valor_unitario") @db.Decimal(12, 2)
  valorTotal    Decimal @map("valor_total") @db.Decimal(12, 2)

  devolucao Devolucao @relation(fields: [devolucaoId], references: [id], onDelete: Cascade)
  produto   Produto   @relation(fields: [produtoId], references: [id])

  @@index([devolucaoId])
  @@map("devolucao_itens")
}

model IaAnaliseLog {
  id                    Int      @id @default(autoincrement())
  clienteId             String   @map("cliente_id")
  vendedorId            String?  @map("vendedor_id")
  disparadoPor          String   @map("disparado_por") // ATENDIMENTO | NOTURNO | MANUAL
  disparadoPorUsuarioId String?  @map("disparado_por_usuario_id")
  atendimentoId         String?  @map("atendimento_id")
  modelo                String   @default("gpt-4o-mini")
  promptEnviado         String   @map("prompt_enviado") @db.Text
  dadosEntrada          Json     @map("dados_entrada")
  respostaIa            Json?    @map("resposta_ia")
  tokensPrompt          Int?     @map("tokens_prompt")
  tokensResposta        Int?     @map("tokens_resposta")
  tokensTotal           Int?     @map("tokens_total")
  duracaoMs             Int?     @map("duracao_ms")
  sucesso               Boolean  @default(true)
  erroMsg               String?  @map("erro_msg")
  criadoEm              DateTime @default(now()) @map("criado_em")

  cliente Cliente @relation(fields: [clienteId], references: [UUID])

  @@index([clienteId])
  @@index([criadoEm(sort: Desc)])
  @@index([vendedorId])
  @@index([disparadoPor])
  @@map("ia_analise_logs")
}

model Curriculo {
  id           Int      @id @default(autoincrement())
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // Dados pessoais
  nome           String
  email          String?
  whatsapp       String
  cpf            String   @unique
  dataNascimento DateTime @map("data_nascimento")
  estadoCivil    String?  @map("estado_civil")
  temFilhos      String?  @map("tem_filhos")
  naturalidade   String?
  endereco       String?
  foto           String?

  // Disponibilidade
  areaInteresse   String  @map("area_interesse")
  horarioInicio   String? @map("horario_inicio")
  horasExtras     String? @map("horas_extras")
  disponibilidade String?

  // Histórico profissional
  empregosRegistrados String? @map("empregos_registrados") @db.Text
  empregosSemRegistro String? @map("empregos_sem_registro") @db.Text
  outrasExperiencias  String? @map("outras_experiencias") @db.Text

  // Campos RH (preenchidos internamente)
  status        String    @default("Novo")
  observacao    String?   @db.Text
  dataAlteracao DateTime? @map("data_alteracao")

  // Verificação de acesso do candidato ao próprio currículo
  // (código enviado ao WhatsApp cadastrado — evita que terceiros vejam/editem dados só com o CPF)
  acessoCodigo     String?   @map("acesso_codigo")
  acessoCodigoExp  DateTime? @map("acesso_codigo_exp")
